[Unit]
Description=SecPal production PostgreSQL
PartOf=secpal.target
Requires=secpal-postgres-init.service
After=secpal-postgres-init.service
StartLimitIntervalSec=60
StartLimitBurst=3
[Container]
ContainerName=secpal-postgres
Image=docker.io/library/postgres@sha256:38471f330eb885e04de130b768d6db4e10469e2311879c7e5c699f6d2d8a1c74
Pull=never
User=999
Group=999
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=all
NoNewPrivileges=true
RunInit=true
StopTimeout=30
LogDriver=k8s-file
LogOpt=path=/srv/secpal/logs/secpal-postgres.log
LogOpt=max-size=10mb
PidsLimit=512
PodmanArgs=--http-proxy=false
PodmanArgs=--pid=private
PodmanArgs=--ipc=private
PodmanArgs=--uts=private
Label=org.secpal.production=true
Label=org.secpal.role=postgres
Entrypoint=["/bin/sh","/run/secpal/bootstrap/production-postgres-entrypoint.sh"]
Exec=run
Mount=type=bind,source=/srv/secpal/config/runtime/production-postgres-entrypoint.sh,target=/run/secpal/bootstrap/production-postgres-entrypoint.sh,ro=true
Mount=type=bind,source=/srv/secpal/postgresql,target=/var/lib/postgresql/data,rw=true
Mount=type=tmpfs,destination=/tmp,tmpfs-size=32m,tmpfs-mode=0700,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/run/postgresql,tmpfs-size=16m,tmpfs-mode=0750,U=true,nosuid=true,nodev=true,noexec=true
Network=secpal-application.network
NetworkAlias=postgres
HealthCmd=pg_isready -U secpal -d secpal
HealthInterval=5s
HealthTimeout=3s
HealthRetries=20
HealthStartPeriod=10s
HealthOnFailure=kill
Notify=healthy
[Service]
ExecStartPre=/usr/bin/podman unshare /usr/local/libexec/secpal/production-state --contract /srv/secpal/config/state-contract.json --validate-namespace --require-secrets
Restart=on-failure
RestartSec=2
TimeoutStartSec=180
