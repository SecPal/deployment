[Unit]
Description=SecPal production frontend
PartOf=secpal.target
Requires=secpal-state-ready.service
After=secpal-state-ready.service
StartLimitIntervalSec=60
StartLimitBurst=3
[Container]
ContainerName=secpal-frontend
Image=ghcr.io/secpal/frontend@sha256:d893b3b5fc3861485f56460e85ba29e7e221cda0a729a192d3749c4c85a7342f
Pull=never
User=101
Group=101
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=all
NoNewPrivileges=true
RunInit=true
StopTimeout=30
LogDriver=k8s-file
LogOpt=path=/srv/secpal/logs/secpal-frontend.log
LogOpt=max-size=10mb
PidsLimit=512
PodmanArgs=--http-proxy=false
PodmanArgs=--pid=private
PodmanArgs=--ipc=private
PodmanArgs=--uts=private
Label=org.secpal.production=true
Label=org.secpal.role=frontend
Mount=type=tmpfs,destination=/tmp,tmpfs-size=32m,tmpfs-mode=0700,U=true,nosuid=true,nodev=true,noexec=true
Network=secpal-edge.network
PublishPort=127.0.0.1:18080:8080/tcp
HealthCmd=curl --fail --silent --show-error --max-time 3 http://127.0.0.1:8080/health/live
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=5s
HealthOnFailure=kill
Notify=healthy
[Service]
ExecStartPre=/usr/bin/python3 -I /usr/local/libexec/secpal/product-backend-policy --check
ExecStartPre=/usr/bin/podman unshare /usr/local/libexec/secpal/production-state --contract /srv/secpal/config/state-contract.json --validate-namespace --require-secrets
Restart=on-failure
RestartSec=2
TimeoutStartSec=180
