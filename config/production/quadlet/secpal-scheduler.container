[Unit]
Description=SecPal production scheduler
PartOf=secpal.target
Requires=secpal-migrate.service
After=secpal-migrate.service
StartLimitIntervalSec=60
StartLimitBurst=3
[Container]
ContainerName=secpal-scheduler
Image=ghcr.io/secpal/api@sha256:ac97416f3feac5c57204421059105389c9add2cfbcda1b063eadf4c6ad7647ab
Pull=never
User=10001
Group=10001
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=all
NoNewPrivileges=true
RunInit=true
StopTimeout=30
LogDriver=k8s-file
LogOpt=path=/srv/secpal/logs/secpal-scheduler.log
LogOpt=max-size=10mb
PidsLimit=512
PodmanArgs=--http-proxy=false
PodmanArgs=--pid=private
PodmanArgs=--ipc=private
PodmanArgs=--uts=private
Label=org.secpal.production=true
Label=org.secpal.role=scheduler
Environment=APP_DEBUG=false
Environment=APP_ENV=production
Environment=APP_NAME=SecPal
Environment=CACHE_STORE=database
Environment=DB_CONNECTION=pgsql
Environment=DB_DATABASE=secpal
Environment=DB_HOST=db.secpal.internal
Environment=DB_PORT=5432
Environment=DB_SSLMODE=verify-full
Environment=DB_SSLROOTCERT=/run/secpal/secrets/database/postgres-ca.crt
Environment=FILESYSTEM_DISK=local
Environment=LOG_CHANNEL=stderr
Environment=QUEUE_CONNECTION=database
Environment=SESSION_DRIVER=database
Exec=php artisan schedule:work
Mount=type=bind,source=/srv/secpal/config/php/99-secpal-secrets.ini,target=/usr/local/etc/php/conf.d/99-secpal-secrets.ini,ro=true
Mount=type=bind,source=/srv/secpal/config/runtime/production-secret-bootstrap.php,target=/run/secpal/bootstrap/production-secret-bootstrap.php,ro=true
Mount=type=bind,source=/run/secpal/secrets/api/app-key,target=/run/secpal/secrets/api/app-key,ro=true
Mount=type=bind,source=/run/secpal/secrets/api/app-previous-keys,target=/run/secpal/secrets/api/app-previous-keys,ro=true
Mount=type=bind,source=/run/secpal/secrets/api/tenant-kek,target=/run/secpal/secrets/api/tenant-kek,ro=true
Mount=type=bind,source=/run/secpal/secrets/runtime/postgres-username,target=/run/secpal/secrets/database/postgres-username,ro=true
Mount=type=bind,source=/run/secpal/secrets/runtime/postgres-password,target=/run/secpal/secrets/database/postgres-password,ro=true
Mount=type=bind,source=/run/secpal/secrets/runtime/postgres-ca.crt,target=/run/secpal/secrets/database/postgres-ca.crt,ro=true
Mount=type=bind,source=/srv/secpal/private-storage,target=/app/storage/app/private,rw=true
Mount=type=bind,source=/srv/secpal/public-storage,target=/app/storage/app/public,rw=true
Mount=type=tmpfs,destination=/tmp,tmpfs-size=32m,tmpfs-mode=0700,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/config,tmpfs-size=16m,tmpfs-mode=0700,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/data,tmpfs-size=16m,tmpfs-mode=0700,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/app/storage/framework/cache/data,tmpfs-size=32m,tmpfs-mode=0750,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/app/storage/framework/sessions,tmpfs-size=32m,tmpfs-mode=0750,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/app/storage/framework/views,tmpfs-size=32m,tmpfs-mode=0750,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/app/storage/logs,tmpfs-size=32m,tmpfs-mode=0750,U=true,nosuid=true,nodev=true,noexec=true
Mount=type=tmpfs,destination=/app/bootstrap/cache,tmpfs-size=16m,tmpfs-mode=0750,U=true,nosuid=true,nodev=true,noexec=true
Network=pasta:--no-map-gw,--map-guest-addr,none,--map-host-loopback,169.254.81.1
AddHost=db.secpal.internal:169.254.81.1
[Service]
ExecStartPre=/usr/bin/podman unshare /usr/local/libexec/secpal/production-state --contract /srv/secpal/config/state-contract.json --validate-namespace --require-secrets
Restart=on-failure
RestartSec=2
TimeoutStartSec=180
