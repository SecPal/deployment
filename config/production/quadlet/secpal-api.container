[Unit]
Description=SecPal production API HTTP
PartOf=secpal.target secpal-php-fpm.service
Requires=secpal-php-fpm.service
After=secpal-php-fpm.service
StartLimitIntervalSec=60
StartLimitBurst=3
[Container]
ContainerName=secpal-api
Image=ghcr.io/secpal/api@sha256:f912cd93778454b7c3910e559a5773c9c0532347e07d8e99ee7be231b5f9795c
Pull=never
User=10001
Group=10001
ReadOnly=true
ReadOnlyTmpfs=false
DropCapability=all
NoNewPrivileges=true
RunInit=true
StopTimeout=30
StopSignal=SIGQUIT
LogDriver=k8s-file
LogOpt=path=/srv/secpal/logs/secpal-api.log
LogOpt=max-size=10mb
PidsLimit=512
PodmanArgs=--http-proxy=false
PodmanArgs=--pid=private
PodmanArgs=--ipc=private
PodmanArgs=--uts=private
Label=org.secpal.production=true
Label=org.secpal.role=api
Volume=secpal-fpm.volume:/run/secpal-fpm:ro,z
Mount=type=bind,source=/srv/secpal/public-storage,target=/app/storage/app/public,ro=true
Mount=type=tmpfs,destination=/tmp,tmpfs-size=32m,tmpfs-mode=0700,U=true,nosuid=true,nodev=true,noexec=true
Network=secpal-edge.network
PublishPort=127.0.0.1:18081:8080/tcp
HealthCmd=/usr/local/bin/secpal-http-live
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=15s
HealthOnFailure=kill
Notify=healthy
[Service]
ExecStartPre=/usr/bin/python3 -I /usr/local/libexec/secpal/product-backend-policy --check
ExecStartPre=/usr/bin/podman unshare /usr/local/libexec/secpal/production-state --contract /srv/secpal/config/state-contract.json --validate-namespace --require-secrets
Restart=on-failure
RestartSec=2
TimeoutStartSec=180
