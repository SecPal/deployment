[Unit]
Description=SecPal DIRECT certificate health facts
BindsTo=secpal-acme-policy.service
After=secpal-acme-policy.service haproxy.service

[Service]
Type=oneshot
User=root
Group=root
SELinuxContext=system_u:system_r:unconfined_service_t:s0
# Verify signed package payloads in PID 1's host filesystem view before the
# sandboxed controller consumes the successful current ExecStartPre via D-Bus.
ExecStartPre=+/usr/bin/python3 -I -S /usr/local/libexec/secpal/viewer-tls-source/scripts/direct-viewer-tls.py --verify-packages
ExecStart=/usr/bin/python3 -I -S /usr/local/libexec/secpal/viewer-tls-source/scripts/direct-viewer-tls.py --health
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/secpal-viewer-tls
ReadWritePaths=-/var/log/dnf.log -/var/log/dnf.librepo.log -/var/log/hawkey.log -/var/cache/dnf
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SocketBindDeny=any
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secpal-viewer-tls-health
