[Unit]
Description=SecPal DIRECT Viewer certificate renewal
BindsTo=secpal-acme-policy.service
After=secpal-acme-policy.service haproxy.service

[Service]
Type=oneshot
User=root
Group=root
SELinuxContext=system_u:system_r:unconfined_service_t:s0
ExecStart=/usr/bin/python3 -I -S /usr/local/libexec/secpal/viewer-tls-source/scripts/direct-viewer-tls.py --renew
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/secpal/acme /etc/haproxy /run/secpal-viewer-tls
ReadWritePaths=-/var/log/dnf.log -/var/log/dnf.librepo.log -/var/log/hawkey.log -/var/cache/dnf
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:18084
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
InaccessiblePaths=-/run/docker.sock -/run/podman -/run/user -/var/lib/containers -/srv/secpal/secrets
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secpal-viewer-tls
