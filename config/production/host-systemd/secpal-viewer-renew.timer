[Unit]
Description=Bounded SecPal DIRECT certificate renewal schedule

[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=30min
AccuracySec=1min
Persistent=true
Unit=secpal-viewer-renew.service

[Install]
WantedBy=timers.target
