[Unit]
Description=Validate SecPal production state before product startup
Before=secpal-valkey.service secpal-migrate.service
PartOf=secpal.target
[Service]
Type=oneshot
ExecStart=/usr/bin/podman unshare /usr/local/libexec/secpal/production-state --contract /srv/secpal/config/state-contract.json --validate-namespace --require-secrets
RemainAfterExit=yes
