#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 SecPal Contributors
# SPDX-License-Identifier: MIT

set -euo pipefail

readonly metadata=http://169.254.169.254/computeMetadata/v1
metadata_value() {
  curl --noproxy '*' --fail --silent --show-error --max-time 5 \
    -H 'Metadata-Flavor: Google' "$metadata/$1"
}

# All source bytes are admitted before any trusted component is installed or
# executed. The original fixed component identities share one gzip dictionary.
umask 077
transport_directory="$(mktemp -d /var/lib/secpal-rocky-transport.XXXXXXXX)"
trap 'rm -rf -- "$transport_directory"' EXIT
python3 - "$transport_directory" <<'PYTHON_TRANSPORT'
import base64
import hashlib
import json
import pathlib
import sys
import zlib

try:
    encoded = '${payload_base64gzip}'
    expected_size = ${payload_bytes}
    if not 0 < expected_size <= 1024 * 1024:
        raise ValueError()
    compressed = base64.b64decode(encoded, validate=True)
    decoder = zlib.decompressobj(wbits=31)
    payload = decoder.decompress(compressed, expected_size + 1)
    if (len(payload) != expected_size or not decoder.eof
            or decoder.unconsumed_tail or decoder.unused_data
            or hashlib.sha256(payload).hexdigest() != '${payload_sha256}'):
        raise ValueError()
    def unique_object(pairs):
        result = dict(pairs)
        if len(result) != len(pairs):
            raise ValueError()
        return result
    sources = json.loads(payload, object_pairs_hook=unique_object)
    names = json.loads(base64.b64decode('${component_names_base64}', validate=True))
    if (not isinstance(sources, dict) or sorted(sources) != names
            or len(names) != len(set(names))
            or any(not isinstance(value, str) for value in sources.values())
            or any(not name.replace('_', '').isalnum() or not name.isascii() for name in names)):
        raise ValueError()
    directory = pathlib.Path(sys.argv[1])
    for name in names:
        (directory / name).write_bytes(sources[name].encode('utf-8'))
except (ValueError, TypeError, KeyError, OSError, zlib.error):
    sys.exit('ROCKY_BOOTSTRAP_TRANSPORT_INTEGRITY_FAILED')
PYTHON_TRANSPORT

decode_script() {
  local component="$1" destination="$2"
  install -o root -g root -m 0700 -- "$transport_directory/$component" "$destination"
}

install -d -o root -g root -m 0700 /var/lib/secpal-rocky /var/lib/secpal-rocky/evidence
readonly qualification_readiness=/var/lib/secpal-rocky/qualification-readiness.json
rm -f -- "$qualification_readiness"
install -d -o root -g root -m 0755 /opt/secpal-control/scripts/ci-cloud \
  /opt/secpal-control/config/ci-cloud /opt/secpal-control/schemas \
  /usr/local/libexec/secpal-control
install -d -o root -g root -m 0700 /opt/secpal-control/libexec
%{ if product_backend_policy_enabled ~}
# #101 proof executes the accepted-control byte closure, never target PR code.
install -d -o root -g root -m 0755 /opt/secpal-control/config/production/quadlet \
  /opt/secpal-control/config/production/host-systemd
decode_script 'backend_policy' /opt/secpal-control/scripts/product-backend-policy.py
decode_script 'backend_contract' /opt/secpal-control/scripts/product_backend_contract.py
decode_script 'backend_service' /opt/secpal-control/config/production/host-systemd/secpal-product-backend-policy.service
decode_script 'backend_qualifier' /opt/secpal-control/scripts/ci-cloud/qualify-product-backends.py
decode_script 'backend_qualification_contract' /opt/secpal-control/scripts/ci-cloud/product_backend_qualification_contract.py
decode_script 'backend_control' /opt/secpal-control/scripts/ci-cloud/product-backend-qualification-control.py
decode_script 'backend_wrapper' /opt/secpal-control/scripts/ci-cloud/run-product-backend-qualification.sh
decode_script 'backend_api' /opt/secpal-control/config/production/quadlet/secpal-api.container
decode_script 'backend_frontend' /opt/secpal-control/config/production/quadlet/secpal-frontend.container
decode_script 'backend_edge_network' /opt/secpal-control/config/production/quadlet/secpal-edge.network
decode_script 'backend_application_network' /opt/secpal-control/config/production/quadlet/secpal-application.network
decode_script 'backend_state_contract' /opt/secpal-control/config/production/state-contract.json
decode_script 'prepare_script' /opt/secpal-control/scripts/ci-cloud/prepare-rocky-host.sh
decode_script backend_authorization /var/lib/secpal-rocky/product-backend-policy.json
chmod 0600 /var/lib/secpal-rocky/product-backend-policy.json
decode_script backend_wrapper /usr/local/sbin/secpal-qualify-product-backends
%{ endif ~}
# Separate PostgreSQL authority; the frozen host harness/claim remains intact.
%{ if !product_backend_policy_enabled ~}
decode_script 'postgresql_contract' /opt/secpal-control/scripts/ci-cloud/postgresql_qualification_contract.py
decode_script 'postgresql_control' /opt/secpal-control/scripts/ci-cloud/postgresql-qualification-control.py
decode_script 'postgresql_runner' /opt/secpal-control/scripts/ci-cloud/qualify-native-postgresql.py
decode_script 'postgresql_application_bootstrap' /opt/secpal-control/scripts/ci-cloud/postgresql-application-bootstrap.php
decode_script 'postgresql_application_probe' /opt/secpal-control/scripts/ci-cloud/postgresql-application-probe.php
decode_script 'image_attestation_runtime' /opt/secpal-control/scripts/image_attestation_runtime.py
decode_script 'fetch_oci_attestation' /opt/secpal-control/scripts/fetch-oci-attestation.py
decode_script 'postgresql_wrapper' /opt/secpal-control/scripts/ci-cloud/run-native-postgresql-qualification.sh
decode_script 'postgresql_wrapper' /usr/local/sbin/secpal-qualify-native-postgresql
decode_script 'postgresql_diagnostic_schema' /opt/secpal-control/schemas/postgresql-qualification-diagnostic.schema.json
decode_script 'postgresql_schema' /opt/secpal-control/schemas/postgresql-qualification-evidence.schema.json
decode_script 'postgresql_consumer' /opt/secpal-control/scripts/render-native-postgresql.py
decode_script 'integration_runtime_contract' /opt/secpal-control/scripts/integration_runtime_contract.py
%{ endif ~}
decode_script 'preparation_contract' /opt/secpal-control/scripts/ci-cloud/rocky_preparation_contract.py
decode_script 'collector' /opt/secpal-control/scripts/ci-cloud/collect-rocky-preparation.py
decode_script postgresql_candidate /var/lib/secpal-rocky/postgresql-candidate.json
chown root:root /var/lib/secpal-rocky/postgresql-candidate.json
chmod 0600 /var/lib/secpal-rocky/postgresql-candidate.json
decode_script 'prepare_script' /usr/local/sbin/secpal-prepare-rocky-host
decode_script 'readiness_publisher' /usr/local/sbin/secpal-publish-rocky-qualification-readiness
decode_script 'runtime_user_systemd' /usr/local/sbin/runtime_user_systemd.py
decode_script 'runtime_user_systemd' /opt/secpal-control/scripts/ci-cloud/runtime_user_systemd.py
decode_script 'target_runner' /usr/local/sbin/secpal-run-rocky-target-qualification
decode_script 'target_failure_classifier' /usr/local/sbin/secpal-classify-rocky-target-failure
decode_script 'target_replay_verifier' /usr/local/sbin/secpal-verify-rocky-target-replay
decode_script 'target_trace' /opt/secpal-control/scripts/ci-cloud/rocky-target-qualification-trace.sh
decode_script 'reload_runuser' /opt/secpal-control/libexec/rocky-reload-runuser
decode_script 'reload_systemctl' /usr/local/libexec/secpal-control/rocky-reload-systemctl
chmod 0555 /usr/local/libexec/secpal-control/rocky-reload-systemctl
decode_script 'start_runuser' /opt/secpal-control/libexec/rocky-start-runuser
decode_script 'start_env' /usr/local/libexec/secpal-control/rocky-start-env
decode_script 'start_systemctl' /usr/local/libexec/secpal-control/rocky-start-systemctl
chmod 0555 /usr/local/libexec/secpal-control/rocky-start-env \
  /usr/local/libexec/secpal-control/rocky-start-systemctl
decode_script 'active_runuser' /opt/secpal-control/libexec/rocky-active-runuser
decode_script 'active_env' /usr/local/libexec/secpal-control/rocky-active-env
decode_script 'active_systemctl' /usr/local/libexec/secpal-control/rocky-active-systemctl
chmod 0555 /usr/local/libexec/secpal-control/rocky-active-env \
  /usr/local/libexec/secpal-control/rocky-active-systemctl
decode_script 'primary_runuser' /opt/secpal-control/libexec/rocky-primary-runuser
decode_script 'primary_runtime' /usr/local/libexec/secpal-control/rocky-primary-runtime
chmod 0555 /usr/local/libexec/secpal-control/rocky-primary-runtime
for trusted_directory in / /opt /opt/secpal-control \
  /opt/secpal-control/libexec /opt/secpal-control/scripts \
  /opt/secpal-control/scripts/ci-cloud /usr /usr/local /usr/local/libexec \
  /usr/local/libexec/secpal-control; do
  [[ -d "$trusted_directory" && ! -L "$trusted_directory" ]]
  [[ "$(stat -c '%u:%g' -- "$trusted_directory")" == 0:0 ]]
  trusted_mode="$(stat -c '%a' -- "$trusted_directory")"
  (( (8#$trusted_mode & 8#022) == 0 ))
done
[[ "$(stat -c '%u:%g:%a' -- /opt/secpal-control/libexec/rocky-reload-runuser)" == \
  0:0:700 ]]
[[ "$(stat -c '%u:%g:%a' -- /usr/local/libexec/secpal-control/rocky-reload-systemctl)" == \
  0:0:555 ]]
[[ "$(stat -c '%u:%g:%a' -- /opt/secpal-control/libexec/rocky-start-runuser)" == \
  0:0:700 ]]
[[ "$(stat -c '%u:%g:%a' -- /usr/local/libexec/secpal-control/rocky-start-env)" == \
  0:0:555 ]]
[[ "$(stat -c '%u:%g:%a' -- /usr/local/libexec/secpal-control/rocky-start-systemctl)" == \
  0:0:555 ]]
[[ "$(stat -c '%u:%g:%a' -- /opt/secpal-control/libexec/rocky-active-runuser)" == \
  0:0:700 ]]
[[ "$(stat -c '%u:%g:%a' -- /usr/local/libexec/secpal-control/rocky-active-env)" == \
  0:0:555 ]]
[[ "$(stat -c '%u:%g:%a' -- /usr/local/libexec/secpal-control/rocky-active-systemctl)" == \
  0:0:555 ]]
[[ "$(stat -c '%u:%g:%a' -- /opt/secpal-control/libexec/rocky-primary-runuser)" == \
  0:0:700 ]]
[[ "$(stat -c '%u:%g:%a' -- /usr/local/libexec/secpal-control/rocky-primary-runtime)" == \
  0:0:555 ]]
decode_script 'reload_observer' /opt/secpal-control/scripts/ci-cloud/observe-rocky-quadlet-reload-adjacency.py
decode_script 'allocator' /usr/local/sbin/secpal-allocate-rocky-subids
decode_script 'collector' /usr/local/sbin/secpal-collect-rocky-preparation
decode_script 'preparation_contract' /usr/local/sbin/rocky_preparation_contract.py
decode_script 'control_utility' /opt/secpal-control/scripts/ci-cloud/rocky-control.py
decode_script 'selinux_isolation_contract' /opt/secpal-control/scripts/selinux_isolation_contract.py
decode_script 'quadlet_authority_contract' /opt/secpal-control/scripts/quadlet_authority_contract.py
decode_script 'discovery_schema' /opt/secpal-control/schemas/rocky-cloud-discovery-evidence.schema.json
decode_script 'continuation_schema' /opt/secpal-control/schemas/rocky-cloud-continuation.schema.json
decode_script 'preparation_schema' /opt/secpal-control/schemas/rocky-cloud-preparation-evidence.schema.json
decode_script 'preparation_failure_schema' /opt/secpal-control/schemas/rocky-cloud-preparation-failure-evidence.schema.json
decode_script 'qualification_schema' /opt/secpal-control/schemas/rocky-cloud-qualification-evidence.schema.json
decode_script 'target_source_failure_schema' /opt/secpal-control/schemas/rocky-cloud-target-source-failure.schema.json
decode_script 'target_qualification_failure_schema' /opt/secpal-control/schemas/rocky-cloud-target-qualification-failure.schema.json
profile="$(metadata_value instance/attributes/secpal-rocky-provider-profile)"
case "$profile" in
  gcp-rocky-10-2-arm64)
    decode_script 'arm64_profile' \
      /opt/secpal-control/config/ci-cloud/gcp-rocky-10-2-arm64.json
    ;;
  gcp-rocky-10-2-x86-64)
    decode_script 'x86_64_profile' \
      /opt/secpal-control/config/ci-cloud/gcp-rocky-10-2-x86-64.json
    ;;
  *) exit 1 ;;
esac
chmod 0644 /opt/secpal-control/schemas/*.json /opt/secpal-control/config/ci-cloud/*.json

public_key="$(metadata_value instance/attributes/secpal-rocky-ssh-public-key)"
[[ "$public_key" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+={0,2}\ secpal-rocky-[1-9][0-9]{0,19}-[1-9][0-9]{0,2}$ ]]
if ! getent passwd secpal-cloud >/dev/null; then
  useradd --system --create-home --home-dir /var/lib/secpal-cloud --shell /bin/bash secpal-cloud
fi
install -d -o secpal-cloud -g secpal-cloud -m 0700 /var/lib/secpal-cloud/.ssh
printf '%s\n' "$public_key" >/var/lib/secpal-cloud/.ssh/authorized_keys
chown secpal-cloud:secpal-cloud /var/lib/secpal-cloud/.ssh/authorized_keys
chmod 0600 /var/lib/secpal-cloud/.ssh/authorized_keys

admitted="$(metadata_value instance/attributes/secpal-rocky-cloud-identity-admitted)"
[[ "$admitted" == true ]] || exit 0
if identities="$(metadata_value instance/service-accounts/ 2>/dev/null)"; then
  [[ -z "$identities" ]]
fi
install -o root -g root -m 0600 /dev/null /var/lib/secpal-rocky/cloud-identity-absent

target_sha="$(metadata_value instance/attributes/secpal-rocky-target-sha)"
control_sha="$(metadata_value instance/attributes/secpal-rocky-trusted-control-sha)"
access_run_id="$(metadata_value instance/attributes/secpal-rocky-access-run-id)"
access_run_attempt="$(metadata_value instance/attributes/secpal-rocky-access-run-attempt)"
image="$(metadata_value instance/attributes/secpal-rocky-exact-image-self-link)"
expires_at="$(metadata_value instance/attributes/secpal-rocky-expires-at)"
[[ "$access_run_id" =~ ^[1-9][0-9]{0,19}$ ]]
[[ "$access_run_attempt" =~ ^[1-9][0-9]{0,2}$ ]]
hostname_value="$(hostname)"
[[ "$hostname_value" =~ ^sprk-([1-9][0-9]{0,19})-([1-9][0-9]{0,2})-instance$ ]]
run_id="$${BASH_REMATCH[1]}"
run_attempt="$${BASH_REMATCH[2]}"

# Capture resource facts before frozen #80 blocks metadata HTTP. This file is
# startup/control-owned; target execution receives no metadata capability.
if [[ -s /var/lib/secpal-rocky/postgresql-candidate.json ]]; then
  instance_id="$(metadata_value instance/id)"
  instance_name="$(metadata_value instance/name)"
  [[ "$instance_id" =~ ^[1-9][0-9]{0,19}$ ]]
  [[ "$instance_name" == "$hostname_value" ]]
  [[ "$control_sha" =~ ^[0-9a-f]{40}$ ]]
  install -o root -g root -m 0600 /dev/null /var/lib/secpal-rocky/postgresql-resource-binding.json
  python3 - "$control_sha" "$profile" "$access_run_id" "$access_run_attempt" \
    "$instance_id" "$instance_name" <<'PYTHON'
import json
import pathlib
import sys
names = ('control_sha', 'profile', 'access_run_id', 'access_run_attempt', 'instance_id', 'instance_name')
pathlib.Path('/var/lib/secpal-rocky/postgresql-resource-binding.json').write_text(
    json.dumps(dict(zip(names, sys.argv[1:]))) + '\n')
PYTHON
fi

%{ if product_backend_policy_enabled ~}
if [[ -s /var/lib/secpal-rocky/product-backend-policy.json ]]; then
  instance_id="$(metadata_value instance/id)"
  instance_name="$(metadata_value instance/name)"
  [[ "$instance_id" =~ ^[1-9][0-9]{0,19}$ && "$instance_name" == "$hostname_value" ]]
  python3 - "$control_sha" "$profile" "$access_run_id" "$access_run_attempt" \
    "$instance_id" "$instance_name" <<'PYTHON_BACKEND_BINDING'
import json
import pathlib
import sys
names = ('control_sha', 'profile', 'run_id', 'run_attempt', 'instance_id', 'instance_name')
path = pathlib.Path('/var/lib/secpal-rocky/product-backend-policy-binding.json')
path.write_text(json.dumps(dict(zip(names, sys.argv[1:]))) + '\n')
path.chmod(0o600)
PYTHON_BACKEND_BINDING
fi
%{ endif ~}

qualification_arguments=()
%{ if product_backend_policy_enabled ~}
qualification_arguments=(product-backend-policy)
%{ endif ~}
/usr/local/sbin/secpal-prepare-rocky-host \
  "$target_sha" "$control_sha" "$run_id" "$run_attempt" "$expires_at" "$image" \
  "$profile" /var/lib/secpal-rocky/evidence/preparation.json "$${qualification_arguments[@]}"

# The initial preparation phase deliberately reboots before the admitted state
# exists.  Only a completed current-boot startup may publish qualification
# readiness; provider RUNNING and SSH reachability alone are insufficient.
if [[ -s /var/lib/secpal-rocky/postgresql-candidate.json ]]; then
  printf '%s\n' 'secpal-cloud ALL=(root) NOPASSWD: /usr/local/sbin/secpal-qualify-native-postgresql [1-9]* [1-9]*' \
    >/etc/sudoers.d/secpal-cloud-postgresql
  chown root:root /etc/sudoers.d/secpal-cloud-postgresql
  chmod 0440 /etc/sudoers.d/secpal-cloud-postgresql
  visudo --check --file=/etc/sudoers.d/secpal-cloud-postgresql
fi
%{ if product_backend_policy_enabled ~}
if [[ -s /var/lib/secpal-rocky/product-backend-policy.json ]]; then
  printf '%s\n' 'secpal-cloud ALL=(root) NOPASSWD: /usr/local/sbin/secpal-qualify-product-backends [1-9]* [1-9]*' \
    >/etc/sudoers.d/secpal-cloud-product-backends
  chown root:root /etc/sudoers.d/secpal-cloud-product-backends
  chmod 0440 /etc/sudoers.d/secpal-cloud-product-backends
  visudo --check --file=/etc/sudoers.d/secpal-cloud-product-backends
fi
%{ endif ~}
[[ -f /var/lib/secpal-rocky/prepared ]]
[[ ! -e /var/lib/secpal-rocky/reboot-pending ]]
boot_id="$(cat /proc/sys/kernel/random/boot_id)"
[[ "$boot_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
public_key_sha256="$(printf '%s\n' "$public_key" | sha256sum | awk '{print $1}')"
[[ "$public_key_sha256" =~ ^[0-9a-f]{64}$ ]]
/usr/local/sbin/secpal-publish-rocky-qualification-readiness \
  --target-sha "$target_sha" \
  --trusted-control-sha "$control_sha" \
  --access-run-id "$access_run_id" \
  --access-run-attempt "$access_run_attempt" \
  --boot-id "$boot_id" \
  --ssh-public-key-sha256 "$public_key_sha256" \
  --output "$qualification_readiness"
