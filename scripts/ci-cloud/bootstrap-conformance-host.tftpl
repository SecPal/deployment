#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 SecPal Contributors
# SPDX-License-Identifier: MIT

set -euo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive
export LC_ALL=C

ssh_public_key='${ssh_public_key}'
runner_ipv4='${runner_ipv4}'
run_id='${run_id}'
run_attempt='${run_attempt}'
failure_writer=/usr/local/sbin/secpal-ci-host-setup-failure
completion_marker=/var/lib/secpal-ci/host-setup-complete
state_root=/var/lib/secpal-ci-bootstrap
pending_file="$state_root/pending"
continuation_service=secpal-ci-bootstrap-continue.service
continuation_unit="/etc/systemd/system/$continuation_service"
context_tmp=""
pending_tmp=""

if [[ -e "$pending_file" || -L "$pending_file" ]]; then
  [[ -d "$state_root" && ! -L "$state_root" ]]
  [[ "$(stat -c '%u:%g:%a' -- "$state_root")" == 0:0:700 ]]
  [[ -f "$pending_file" && ! -L "$pending_file" ]]
  [[ "$(stat -c '%u:%g:%a' -- "$pending_file")" == 0:0:600 ]]
  exit 0
fi

bootstrap_failure() {
  local status=$?
  trap - EXIT
  set +e
  [[ -z "$context_tmp" ]] || rm -f -- "$context_tmp"
  [[ -z "$pending_tmp" ]] || rm -f -- "$pending_tmp"
  if [[ "$status" -ne 0 && -x "$failure_writer" ]] &&
    ! "$failure_writer" read >/dev/null 2>&1; then
    "$failure_writer" write initialize "$status" || true
  fi
  exit "$status"
}

trap bootstrap_failure EXIT

install -d -o root -g root -m 0755 /usr/local/sbin

install -o root -g root -m 0700 /dev/null \
  /usr/local/sbin/secpal-ci-install-diagnostic-ssh
cat > /usr/local/sbin/secpal-ci-install-diagnostic-ssh <<'SECPAL_DIAGNOSTIC_INSTALLER'
${diagnostic_ssh_installer}
SECPAL_DIAGNOSTIC_INSTALLER

install -o root -g root -m 0700 /dev/null \
  /usr/local/sbin/secpal-ci-configure-conformance-host
cat > /usr/local/sbin/secpal-ci-configure-conformance-host <<'SECPAL_HOST_SETUP'
${host_setup_script}
SECPAL_HOST_SETUP

install -o root -g root -m 0700 /dev/null \
  /usr/local/sbin/secpal-ci-continue-bootstrap
cat > /usr/local/sbin/secpal-ci-continue-bootstrap <<'SECPAL_BOOTSTRAP_CONTINUATION'
${bootstrap_continuation_script}
SECPAL_BOOTSTRAP_CONTINUATION

install -o root -g root -m 0755 /dev/null "$failure_writer"
cat > "$failure_writer" <<'SECPAL_FAILURE_WRITER'
${host_setup_failure_script}
SECPAL_FAILURE_WRITER

/usr/local/sbin/secpal-ci-install-diagnostic-ssh \
  "$ssh_public_key" "$runner_ipv4" "$run_id" "$run_attempt"

if [[ -f "$completion_marker" && ! -L "$completion_marker" ]]; then
  trap - EXIT
  exit 0
fi

apt_sources_dir=/etc/apt/sources.list.d
if [[ -L "$apt_sources_dir" ]]; then
  printf 'ERROR: APT source directory must not be a symlink.\n' >&2
  exit 1
fi
install -d -o root -g root -m 0755 "$apt_sources_dir"
if find "$apt_sources_dir" -mindepth 1 -maxdepth 1 \
  ! -type f ! -type l -print -quit | grep -q .; then
  printf 'ERROR: APT source directory contains an unsupported entry.\n' >&2
  exit 1
fi
find "$apt_sources_dir" -mindepth 1 -maxdepth 1 \
  \( -type f -o -type l \) -delete
rm -f -- /etc/apt/sources.list
debian_sources_tmp="$(mktemp "$apt_sources_dir/.debian.sources.XXXXXX")"
cat > "$debian_sources_tmp" <<'SECPAL_DEBIAN_SOURCES'
Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: https://security.debian.org/debian-security
Suites: trixie-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SECPAL_DEBIAN_SOURCES
chown root:root "$debian_sources_tmp"
chmod 0644 "$debian_sources_tmp"
mv -f -- "$debian_sources_tmp" "$apt_sources_dir/debian.sources"

apt_lists_dir=/var/lib/apt/lists
if [[ -L "$apt_lists_dir" ]]; then
  printf 'ERROR: APT lists directory must not be a symlink.\n' >&2
  exit 1
fi
install -d -o root -g root -m 0755 "$apt_lists_dir"
apt_lists_cleanup=/usr/local/sbin/secpal-ci-reset-apt-lists
install -o root -g root -m 0700 /dev/null "$apt_lists_cleanup"
cat > "$apt_lists_cleanup" <<'SECPAL_APT_LISTS_CLEANUP'
#!/usr/bin/env bash
set -euo pipefail

apt_lists_dir=/var/lib/apt/lists
if [[ -L "$apt_lists_dir" || -L "$apt_lists_dir/lock" ]]; then
  printf 'ERROR: APT lists path must not contain a symlink.\n' >&2
  exit 1
fi
find "$apt_lists_dir" -mindepth 1 -maxdepth 1 \
  ! -name lock \( -type f -o -type l \) -delete
SECPAL_APT_LISTS_CLEANUP

apt-get -o DPkg::Lock::Timeout=300 \
  -o "APT::Update::Pre-Invoke::=$apt_lists_cleanup" update

case "$(dpkg --print-architecture)" in
  amd64) kernel_meta_package=linux-image-amd64 ;;
  arm64) kernel_meta_package=linux-image-arm64 ;;
  *)
    printf 'ERROR: host architecture has no admitted Debian kernel package.\n' >&2
    exit 1
    ;;
esac
apt-get -o DPkg::Lock::Timeout=300 install -y \
  --no-install-recommends -- "$kernel_meta_package"

apt-get -o DPkg::Lock::Timeout=300 install -y --no-install-recommends \
  aardvark-dns \
  apparmor \
  apparmor-utils \
  crun \
  curl \
  dbus-user-session \
  gh \
  git \
  jq \
  netavark \
  passt \
  podman \
  python3 \
  python3-jsonschema \
  python3-yaml \
  uidmap \
  unattended-upgrades

if getent passwd secpal-ci >/dev/null || getent group secpal-ci >/dev/null; then
  user_entry="$(getent passwd secpal-ci || true)"
  group_entry="$(getent group secpal-ci || true)"
  IFS=: read -r user_name _ user_uid user_gid _ user_home user_shell \
    <<<"$user_entry"
  IFS=: read -r group_name _ group_gid group_members <<<"$group_entry"
  [[ "$user_name" == secpal-ci && "$group_name" == secpal-ci &&
    "$user_uid" == 20000 && "$user_gid" == "$group_gid" &&
    "$user_home" == /home/secpal-ci && "$user_shell" == /bin/bash &&
    -z "$group_members" ]]
else
  groupadd --gid 20000 secpal-ci
  useradd --uid 20000 --gid 20000 --create-home \
    --home-dir /home/secpal-ci --shell /bin/bash secpal-ci
fi
# OpenSSH's portable account check can reject a leading "!" lock before
# public-key authentication, while PAM stacks may differ. Keep the password
# unusable without relying on either behavior; password and keyboard-interactive
# authentication remain disabled in the effective daemon policy below.
usermod --password '*NP*' secpal-ci
operator_shadow_entry="$(getent shadow secpal-ci)"
IFS=: read -r operator_shadow_name operator_password_marker _ \
  <<<"$operator_shadow_entry"
[[ "$operator_shadow_name" == secpal-ci ]]
[[ "$operator_password_marker" == '*NP*' ]]

install -d -o root -g root -m 0755 /etc/ssh/sshd_config.d
install -o root -g root -m 0644 /dev/null \
  /etc/ssh/sshd_config.d/00-secpal-ci.conf
cat > /etc/ssh/sshd_config.d/00-secpal-ci.conf <<'SECPAL_SSH_CONFIG'
PasswordAuthentication no
KbdInteractiveAuthentication no
MaxSessions 1
PAMServiceName sshd
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PubkeyAcceptedAlgorithms +ssh-ed25519
AuthorizedKeysCommand none
AuthorizedKeysFile /var/lib/secpal-ci/authorized-keys/%u
AuthorizedPrincipalsCommand none
AuthorizedPrincipalsFile none
TrustedUserCAKeys none
RevokedKeys none
RefuseConnection no
StrictModes yes
ChrootDirectory none
ForceCommand none
DisableForwarding yes
PermitTTY no
PermitUserEnvironment no
PermitUserRC no
UseDNS no
UsePAM yes
AllowUsers secpal-ci
SECPAL_SSH_CONFIG

cat > /etc/apt/apt.conf.d/20secpal-ci-periodic <<'SECPAL_APT_PERIODIC'
APT::Periodic::Enable "1";
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
SECPAL_APT_PERIODIC

cat > /etc/apt/apt.conf.d/99secpal-ci-unattended-upgrades <<'SECPAL_UPGRADES'
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
  "origin=Debian,codename=$${distro_codename}-security,label=Debian-Security";
};
Unattended-Upgrade::Automatic-Reboot "false";
#clear Unattended-Upgrade::Package-Blacklist;
Unattended-Upgrade::Package-Blacklist {
  "podman";
  "conmon";
  "crun";
  "netavark";
  "aardvark-dns";
  "passt";
  "uidmap";
  "dbus-user-session";
};
SECPAL_UPGRADES

install -d -o root -g root -m 0755 /etc/environment.d
cat > /etc/environment.d/90-secpal-ci-quadlet.conf <<'SECPAL_QUADLET'
QUADLET_UNIT_DIRS=/etc/containers/systemd/users/20000
SECPAL_QUADLET

expected_kernel_path="$(readlink -e /vmlinuz)"
[[ "$expected_kernel_path" =~ ^/boot/vmlinuz-(6\.12\.[0-9]+[-+._A-Za-z0-9]*)$ ]]
expected_kernel="$${BASH_REMATCH[1]}"
kernel_image_package="linux-image-$expected_kernel"
[[ "$(dpkg-query -W -f '$${Status}' "$kernel_image_package")" == \
  'install ok installed' ]]
installed_kernel_version="$(
  dpkg-query -W -f '$${Version}' "$kernel_image_package"
)"
candidate_kernel_version="$(
  apt-cache policy "$kernel_image_package" |
    sed -n 's/^[[:space:]]*Candidate:[[:space:]]*//p'
)"
[[ -n "$installed_kernel_version" &&
  "$candidate_kernel_version" == "$installed_kernel_version" ]]
initial_boot_id="$(< /proc/sys/kernel/random/boot_id)"
[[ "$initial_boot_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]

[[ ! -e "$state_root" && ! -L "$state_root" ]]
install -d -o root -g root -m 0700 "$state_root"
install -o root -g root -m 0644 /dev/null "$continuation_unit"
cat >"$continuation_unit" <<'SECPAL_CONTINUATION_UNIT'
[Unit]
Description=Continue SecPal CI bootstrap after the bounded kernel reboot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/secpal-ci-bootstrap/pending

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/secpal-ci-continue-bootstrap
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
SECPAL_CONTINUATION_UNIT
systemd-analyze verify "$continuation_unit"
systemctl daemon-reload
systemctl enable secpal-ci-bootstrap-continue.service

context_tmp="$(mktemp "$state_root/.context.XXXXXX")"
pending_tmp="$(mktemp "$state_root/.pending.XXXXXX")"
chmod 0600 "$context_tmp" "$pending_tmp"
printf '%s\n%s\n%s\n%s\n' \
  "$ssh_public_key" "$runner_ipv4" "$run_id" "$run_attempt" >"$context_tmp"
printf '%s\n%s\n' "$expected_kernel" "$initial_boot_id" >"$pending_tmp"
mv -T -- "$context_tmp" "$state_root/context"
context_tmp=""
mv -T -- "$pending_tmp" "$pending_file"
pending_tmp=""

systemctl reboot
