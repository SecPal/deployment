[Unit]
Description=Closed Hetzner maintenance interface

[Socket]
ListenStream=/run/secpal-hetzner/control.sock
SocketMode=0660
SocketUser=root
SocketGroup=codex
DirectoryMode=0755
Backlog=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
