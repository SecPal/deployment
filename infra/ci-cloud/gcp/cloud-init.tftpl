#cloud-config
# SPDX-FileCopyrightText: 2026 SecPal Contributors
# SPDX-License-Identifier: CC0-1.0

bootcmd:
  - - /bin/bash
    - -c
    - |
        ${diagnostic_ssh_installer}
    - secpal-ci-install-diagnostic-ssh
    - "${ssh_public_key}"
    - "${runner_ipv4}"
    - "${run_id}"
    - "${run_attempt}"

package_update: true
package_upgrade: false

packages:
  - aardvark-dns
  - apparmor
  - apparmor-utils
  - crun
  - curl
  - dbus-user-session
  - git
  - gh
  - jq
  - netavark
  - passt
  - podman
  - python3
  - python3-jsonschema
  - python3-yaml
  - uidmap
  - unattended-upgrades

users:
  - name: secpal-ci
    gecos: SecPal disposable conformance operator
    uid: 20000
    lock_passwd: true
    shell: /bin/bash

disable_root: true
ssh_pwauth: false

write_files:
  - path: /run/secpal-ci-authorized-key
    owner: root:root
    permissions: "0600"
    content: |
      ${ssh_public_key}
  - path: /etc/ssh/sshd_config.d/00-secpal-ci.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      MaxSessions 1
      PAMServiceName sshd
      PermitRootLogin no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      PubkeyAcceptedAlgorithms +ssh-ed25519
      AuthorizedKeysCommand none
      AuthorizedKeysFile /var/lib/secpal-ci/authorized-keys/%u
      AuthorizedPrincipalsCommand none
      AuthorizedPrincipalsFile none
      TrustedUserCAKeys none
      RevokedKeys none
      RefuseConnection no
      StrictModes yes
      ChrootDirectory none
      ForceCommand none
      DisableForwarding yes
      PermitTTY no
      PermitUserEnvironment no
      PermitUserRC no
      UseDNS no
      UsePAM yes
      AllowUsers secpal-ci
  - path: /etc/apt/apt.conf.d/20secpal-ci-periodic
    owner: root:root
    permissions: "0644"
    content: |
      APT::Periodic::Enable "1";
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/apt/apt.conf.d/99secpal-ci-unattended-upgrades
    owner: root:root
    permissions: "0644"
    content: |
      #clear Unattended-Upgrade::Origins-Pattern;
      Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=$${distro_codename}-security,label=Debian-Security";
      };
      Unattended-Upgrade::Automatic-Reboot "false";
      #clear Unattended-Upgrade::Package-Blacklist;
      Unattended-Upgrade::Package-Blacklist {
        "podman";
        "conmon";
        "crun";
        "netavark";
        "aardvark-dns";
        "passt";
        "uidmap";
        "dbus-user-session";
      };
  - path: /etc/environment.d/90-secpal-ci-quadlet.conf
    owner: root:root
    permissions: "0644"
    content: |
      QUADLET_UNIT_DIRS=/etc/containers/systemd/users/20000
  - path: /usr/local/sbin/secpal-ci-configure-conformance-host
    owner: root:root
    permissions: "0700"
    content: |
      ${host_setup_script}
  - path: /usr/local/sbin/secpal-ci-host-setup-failure
    owner: root:root
    permissions: "0755"
    content: |
      ${host_setup_failure_script}

runcmd:
  - [/usr/local/sbin/secpal-ci-configure-conformance-host, "${runner_ipv4}"]
