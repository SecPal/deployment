#cloud-config
# SPDX-FileCopyrightText: 2026 SecPal Contributors
# SPDX-License-Identifier: CC0-1.0

package_update: true
package_upgrade: false

packages:
  - aardvark-dns
  - apparmor
  - apparmor-utils
  - crun
  - curl
  - dbus-user-session
  - git
  - jq
  - netavark
  - passt
  - podman
  - python3
  - python3-jsonschema
  - python3-yaml
  - uidmap

users:
  - name: secpal-ci
    gecos: SecPal disposable conformance operator
    groups: []
    lock_passwd: true
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

disable_root: true
ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/90-secpal-ci.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      AllowUsers secpal-ci

runcmd:
  - [bash, -c, "grep -q '^secpal-ci:' /etc/subuid || usermod --add-subuids 200000-265535 secpal-ci"]
  - [bash, -c, "grep -q '^secpal-ci:' /etc/subgid || usermod --add-subgids 200000-265535 secpal-ci"]
  - [loginctl, enable-linger, secpal-ci]
  - [systemctl, enable, --now, apparmor.service]
  - [systemctl, restart, ssh.service]
