{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secpal.example/schemas/rocky-cloud-target-qualification-failure.schema.json",
  "title": "Bounded negative Rocky target-qualification diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "target_sha",
    "trusted_control_sha",
    "qualification_run_id",
    "qualification_run_attempt",
    "harness_sha256",
    "operation",
    "reason",
    "exit_status",
    "diagnostic_input_sha256",
    "diagnostic_input_bytes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "phase": { "const": "target-qualification" },
    "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "trusted_control_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "qualification_run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "qualification_run_attempt": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}$"
    },
    "harness_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operation": {
      "enum": [
        "qualification-harness",
        "qualify-host-identity",
        "qualify-administrator-execution",
        "qualify-fixture-reference",
        "qualify-service-account",
        "qualify-selinux-host",
        "qualify-package-prerequisites",
        "qualify-native-architecture",
        "qualify-cgroup",
        "qualify-rootless-runtime",
        "qualify-fixture-presence",
        "qualify-fixture-setup",
        "qualify-quadlet-authority",
        "qualify-quadlet-daemon-reload",
        "qualify-quadlet-start",
        "qualify-quadlet-active-state",
        "qualify-selinux-storage",
        "qualify-workload-primary",
        "qualify-seccomp",
        "qualify-workload-secondary",
        "qualify-mcs-relationship",
        "qualify-cross-mcs-denial",
        "qualify-avc-correlation",
        "qualify-selinux-policy-restoration",
        "qualify-runtime-fallback-absence",
        "qualify-fixture-cleanup"
      ]
    },
    "reason": {
      "enum": [
        "invariant-failed",
        "command-failed",
        "representation-invalid",
        "cleanup-failed",
        "timeout",
        "unclassified-target-failure"
      ]
    },
    "exit_status": { "type": "integer", "minimum": 1, "maximum": 255 },
    "diagnostic_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic_input_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 135424
    },
    "daemon_reload_adjacency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "capture_complete",
        "captured_before_cleanup",
        "boot_id",
        "manager_active_after_reload_failure",
        "bus_available_after_reload_failure",
        "control_reachable_after_reload_failure",
        "quadlet_input_admitted",
        "quadlet_input",
        "podman_generator_executed",
        "podman_generator_exit_status",
        "podman_generator_accepted_actual_input",
        "generator_failure_observed",
        "generator_failures",
        "generator_failure_ambiguous",
        "generator_observation_reason",
        "selinux_avc_observed",
        "selinux_avc",
        "selinux_avc_ambiguous"
      ],
      "properties": {
        "classification": {
          "enum": [
            "manager-continuity-lost",
            "target-input-invalid",
            "podman-generator-rejected",
            "other-generator-failed",
            "selinux-reload-denied",
            "manager-reload-transaction-failed",
            "diagnostic-unavailable"
          ]
        },
        "capture_complete": { "type": "boolean" },
        "captured_before_cleanup": { "type": "boolean" },
        "boot_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manager_active_after_reload_failure": {
          "type": ["boolean", "null"]
        },
        "bus_available_after_reload_failure": {
          "type": ["boolean", "null"]
        },
        "control_reachable_after_reload_failure": {
          "type": ["boolean", "null"]
        },
        "quadlet_input_admitted": { "type": "boolean" },
        "quadlet_input": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "match_count",
                "present",
                "regular_file",
                "not_symlink",
                "owner_uid",
                "owner_gid",
                "mode",
                "size",
                "sha256"
              ],
              "properties": {
                "match_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "present": { "type": "boolean" },
                "regular_file": { "type": "boolean" },
                "not_symlink": { "type": "boolean" },
                "owner_uid": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "owner_gid": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "mode": {
                  "type": ["string", "null"],
                  "pattern": "^[0-7]{4}$"
                },
                "size": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 4097
                },
                "sha256": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "podman_generator_executed": { "type": "boolean" },
        "podman_generator_exit_status": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "podman_generator_accepted_actual_input": { "type": "boolean" },
        "generator_failure_observed": { "type": "boolean" },
        "generator_failures": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basename", "exit_status"],
            "properties": {
              "basename": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.@+-]{1,128}$"
              },
              "exit_status": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            }
          }
        },
        "generator_failure_ambiguous": { "type": "boolean" },
        "generator_observation_reason": {
          "enum": [
            "none",
            "journal-command-failed",
            "journal-timeout",
            "journal-output-bound-exceeded",
            "candidate-representation-invalid",
            "candidate-generator-unadmitted",
            "candidate-count-exceeded",
            "multiple-causes",
            "observation-unavailable"
          ]
        },
        "selinux_avc_observed": { "type": "boolean" },
        "selinux_avc": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_type",
                "target_type",
                "object_class",
                "denied_permission"
              ],
              "properties": {
                "source_type": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}$"
                },
                "target_type": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}$"
                },
                "object_class": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}$"
                },
                "denied_permission": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}$"
                }
              }
            }
          ]
        },
        "selinux_avc_ambiguous": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": { "const": "qualify-quadlet-daemon-reload" },
          "reason": { "const": "command-failed" }
        },
        "required": ["operation", "reason"]
      },
      "then": { "required": ["daemon_reload_adjacency"] },
      "else": { "not": { "required": ["daemon_reload_adjacency"] } }
    },
    {
      "if": {
        "properties": {
          "reason": { "enum": ["timeout", "unclassified-target-failure"] }
        }
      },
      "then": {
        "properties": { "operation": { "const": "qualification-harness" } }
      }
    },
    {
      "if": { "properties": { "reason": { "const": "cleanup-failed" } } },
      "then": {
        "properties": { "operation": { "const": "qualify-fixture-cleanup" } }
      }
    },
    {
      "if": {
        "properties": {
          "harness_sha256": {
            "const": "ad6d2518aa3f72054e6fa373b05345e7c37c21ac65feb6075eb69f3c434fea53"
          }
        },
        "required": ["harness_sha256"]
      },
      "else": {
        "properties": {
          "operation": { "const": "qualification-harness" },
          "reason": { "const": "representation-invalid" }
        }
      }
    }
  ]
}
