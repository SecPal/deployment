{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/deployment/schemas/capacity-qualification.schema.json",
  "title": "SecPal provider-neutral capacity qualification evidence",
  "description": "Closed version 1 evidence binding a provider-neutral capability claim to effective observations and, optionally, a current provider catalog product.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability", "subject", "qualification"],
  "properties": {
    "schema_version": { "const": 1 },
    "capability": { "$ref": "#/$defs/capability" },
    "subject": { "$ref": "#/$defs/subject" },
    "observations": { "$ref": "#/$defs/observations" },
    "qualification": { "$ref": "#/$defs/qualification" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification": {
            "properties": { "result": { "const": "PASS" } },
            "required": ["result"]
          }
        },
        "required": ["qualification"]
      },
      "then": {
        "required": ["observations"],
        "properties": {
          "observations": { "$ref": "#/$defs/passingObservations" }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "capacityProfile": {
      "description": "Ordered provider-neutral workload envelope. Version 1 defines only M because no defensible lower or larger profile has been measured.",
      "enum": ["M"]
    },
    "computeIsolation": {
      "enum": ["shared", "dedicated-vcpu", "dedicated-host"]
    },
    "cpuArchitecture": {
      "enum": ["amd64", "arm64"]
    },
    "storageCapability": {
      "enum": ["persistent-posix"]
    },
    "topology": {
      "description": "Vocabulary owned by ADR-022; it is independent of capacity.",
      "enum": ["single", "replacement", "ha"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_profile",
        "compute_isolation",
        "cpu_architecture",
        "storage_capability",
        "topology"
      ],
      "properties": {
        "capacity_profile": { "$ref": "#/$defs/capacityProfile" },
        "compute_isolation": { "$ref": "#/$defs/computeIsolation" },
        "cpu_architecture": { "$ref": "#/$defs/cpuArchitecture" },
        "storage_capability": { "$ref": "#/$defs/storageCapability" },
        "topology": { "$ref": "#/$defs/topology" }
      }
    },
    "subject": {
      "oneOf": [
        { "$ref": "#/$defs/providerProductSubject" },
        { "$ref": "#/$defs/selfHostSubject" }
      ]
    },
    "providerProductSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_identity_sha256", "provider_product"],
      "properties": {
        "kind": { "const": "provider-product" },
        "target_identity_sha256": { "$ref": "#/$defs/sha256" },
        "provider_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "product_id",
            "catalog_record_sha256",
            "catalog_observed_at"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "product_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "catalog_record_sha256": { "$ref": "#/$defs/sha256" },
            "catalog_observed_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      }
    },
    "selfHostSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_identity_sha256", "hardware_description"],
      "properties": {
        "kind": { "const": "self-host" },
        "target_identity_sha256": { "$ref": "#/$defs/sha256" },
        "hardware_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "computeIsolationObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "basis"],
          "properties": {
            "classification": { "const": "shared" },
            "basis": { "const": "shared-scheduler" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "basis"],
          "properties": {
            "classification": { "const": "dedicated-vcpu" },
            "basis": { "const": "dedicated-vcpu-entitlement" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "basis"],
          "properties": {
            "classification": { "const": "dedicated-host" },
            "basis": { "const": "exclusive-physical-host" }
          }
        }
      ]
    },
    "cpuObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "architecture",
            "instruction_set_level",
            "vendor",
            "model"
          ],
          "properties": {
            "architecture": { "const": "amd64" },
            "instruction_set_level": {
              "enum": ["x86-64-v3", "x86-64-v4"]
            },
            "vendor": { "type": "string", "minLength": 1, "maxLength": 128 },
            "model": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "architecture",
            "instruction_set_level",
            "vendor",
            "model"
          ],
          "properties": {
            "architecture": { "const": "arm64" },
            "instruction_set_level": { "const": "arm64" },
            "vendor": { "type": "string", "minLength": 1, "maxLength": 128 },
            "model": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      ]
    },
    "resourceObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usable_cpu_millicores",
        "online_logical_cpus",
        "usable_memory_bytes",
        "total_storage_bytes",
        "free_storage_bytes",
        "total_inodes",
        "free_inodes"
      ],
      "properties": {
        "usable_cpu_millicores": {
          "description": "Trusted effective affinity/quota scheduling ceiling. This is not by itself proof of sustained compute delivery; the reviewed workload reservation supplies that evidence.",
          "type": "integer",
          "minimum": 1
        },
        "online_logical_cpus": { "type": "integer", "minimum": 1 },
        "usable_memory_bytes": { "type": "integer", "minimum": 1 },
        "total_storage_bytes": { "type": "integer", "minimum": 1 },
        "free_storage_bytes": { "type": "integer", "minimum": 0 },
        "total_inodes": { "type": "integer", "minimum": 1 },
        "free_inodes": { "type": "integer", "minimum": 0 }
      }
    },
    "workloadObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "probe_revision_sha256",
        "duration_seconds",
        "completed_iterations",
        "failed_iterations",
        "deadline_misses",
        "oom_events",
        "peak_cpu_millicores",
        "peak_memory_bytes"
      ],
      "properties": {
        "probe_id": { "const": "secpal-capacity-workload-v1" },
        "probe_revision_sha256": { "$ref": "#/$defs/sha256" },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "completed_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "failed_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "deadline_misses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "oom_events": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "peak_cpu_millicores": { "type": "integer", "minimum": 1 },
        "peak_memory_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "storageObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment",
        "persistence",
        "filesystem",
        "fsync_supported",
        "performance"
      ],
      "properties": {
        "attachment": { "enum": ["local-block", "network-block"] },
        "persistence": { "enum": ["ephemeral", "persistent"] },
        "filesystem": { "enum": ["ext4", "xfs"] },
        "fsync_supported": { "type": "boolean" },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probe_id",
            "probe_revision_sha256",
            "duration_seconds",
            "random_read_iops",
            "random_write_iops",
            "sequential_read_bytes_per_second",
            "sequential_write_bytes_per_second",
            "fsync_p95_microseconds"
          ],
          "properties": {
            "probe_id": { "const": "secpal-capacity-storage-v1" },
            "probe_revision_sha256": { "$ref": "#/$defs/sha256" },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "random_read_iops": { "type": "integer", "minimum": 0 },
            "random_write_iops": { "type": "integer", "minimum": 0 },
            "sequential_read_bytes_per_second": {
              "type": "integer",
              "minimum": 0
            },
            "sequential_write_bytes_per_second": {
              "type": "integer",
              "minimum": 0
            },
            "fsync_p95_microseconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compute_isolation",
        "cpu",
        "resources",
        "workload",
        "storage"
      ],
      "properties": {
        "compute_isolation": { "$ref": "#/$defs/computeIsolationObservation" },
        "cpu": { "$ref": "#/$defs/cpuObservation" },
        "resources": { "$ref": "#/$defs/resourceObservations" },
        "workload": { "$ref": "#/$defs/workloadObservation" },
        "storage": { "$ref": "#/$defs/storageObservation" }
      }
    },
    "passingObservations": {
      "allOf": [
        { "$ref": "#/$defs/observations" },
        {
          "properties": {
            "resources": {
              "properties": {
                "usable_cpu_millicores": { "minimum": 4000 },
                "online_logical_cpus": { "minimum": 4 },
                "usable_memory_bytes": { "minimum": 8589934592 },
                "total_storage_bytes": { "minimum": 107374182400 },
                "free_storage_bytes": { "minimum": 21474836480 },
                "total_inodes": { "minimum": 1000000 },
                "free_inodes": { "minimum": 200000 }
              }
            },
            "workload": {
              "properties": {
                "duration_seconds": { "minimum": 600 },
                "completed_iterations": { "minimum": 1 },
                "failed_iterations": { "const": 0 },
                "deadline_misses": { "const": 0 },
                "oom_events": { "const": 0 }
              }
            },
            "storage": {
              "properties": {
                "persistence": { "const": "persistent" },
                "fsync_supported": { "const": true },
                "performance": {
                  "properties": {
                    "duration_seconds": { "minimum": 60 },
                    "random_read_iops": { "minimum": 1 },
                    "random_write_iops": { "minimum": 1 },
                    "sequential_read_bytes_per_second": { "minimum": 1 },
                    "sequential_write_bytes_per_second": { "minimum": 1 },
                    "fsync_p95_microseconds": { "minimum": 1 }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha",
        "trusted_control_sha",
        "workload_probe_revision_sha256",
        "storage_probe_revision_sha256",
        "observed_at",
        "valid_until",
        "freshness_seconds",
        "result",
        "source_evidence_sha256",
        "cleanup"
      ],
      "properties": {
        "target_sha": { "$ref": "#/$defs/sha" },
        "trusted_control_sha": { "$ref": "#/$defs/sha" },
        "workload_probe_revision_sha256": { "$ref": "#/$defs/sha256" },
        "storage_probe_revision_sha256": { "$ref": "#/$defs/sha256" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "freshness_seconds": { "const": 2592000 },
        "result": { "enum": ["PASS", "FAIL", "UNAVAILABLE", "UNKNOWN"] },
        "source_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "cleanup": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status"],
              "properties": {
                "required": { "const": true },
                "status": { "enum": ["complete", "incomplete", "unknown"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status"],
              "properties": {
                "required": { "const": false },
                "status": { "const": "not-required" }
              }
            }
          ]
        }
      }
    },
    "capacitySourceEvidence": {
      "description": "Trusted-controller source observations from which one PASS artifact is independently admitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "capability",
        "subject",
        "observations",
        "collection",
        "cleanup"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collector",
            "target_sha",
            "trusted_control_sha",
            "target_identity_sha256",
            "workload_probe_revision_sha256",
            "storage_probe_revision_sha256",
            "observed_at"
          ],
          "properties": {
            "collector": { "const": "trusted-controller" },
            "target_sha": { "$ref": "#/$defs/sha" },
            "trusted_control_sha": { "$ref": "#/$defs/sha" },
            "target_identity_sha256": { "$ref": "#/$defs/sha256" },
            "workload_probe_revision_sha256": { "$ref": "#/$defs/sha256" },
            "storage_probe_revision_sha256": { "$ref": "#/$defs/sha256" },
            "observed_at": { "$ref": "#/$defs/timestamp" }
          }
        },
        "capability": { "$ref": "#/$defs/capability" },
        "subject": { "$ref": "#/$defs/subject" },
        "observations": { "$ref": "#/$defs/passingObservations" },
        "cleanup": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status"],
              "properties": {
                "required": { "const": true },
                "status": { "enum": ["complete", "incomplete", "unknown"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "status"],
              "properties": {
                "required": { "const": false },
                "status": { "const": "not-required" }
              }
            }
          ]
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workload", "storage"],
          "properties": {
            "workload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observer",
                "controller_observed_duration_seconds",
                "controller_observed_completed_iterations",
                "controller_observed_failed_iterations",
                "controller_observed_deadline_misses",
                "controller_observed_oom_events",
                "cpu_reservation_requested_millicores",
                "cpu_reservation_delivered_millicores",
                "cpu_reservation_observed_seconds",
                "memory_reservation_bytes",
                "memory_reservation_held_seconds",
                "target_results_authoritative"
              ],
              "properties": {
                "observer": { "const": "trusted-controller" },
                "controller_observed_duration_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
                },
                "controller_observed_completed_iterations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "controller_observed_failed_iterations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "controller_observed_deadline_misses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "controller_observed_oom_events": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "cpu_reservation_requested_millicores": {
                  "type": "integer",
                  "minimum": 0
                },
                "cpu_reservation_delivered_millicores": {
                  "type": "integer",
                  "minimum": 0
                },
                "cpu_reservation_observed_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
                },
                "memory_reservation_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "memory_reservation_held_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
                },
                "target_results_authoritative": { "const": false }
              }
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observer",
                "controller_observed_cycles_completed",
                "controller_observed_deadline_misses",
                "maximum_cycle_duration_microseconds",
                "same_persistent_filesystem_observed"
              ],
              "properties": {
                "observer": { "const": "trusted-controller" },
                "controller_observed_cycles_completed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "controller_observed_deadline_misses": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "maximum_cycle_duration_microseconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "same_persistent_filesystem_observed": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
