{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/deployment/schemas/production-host-facts.schema.json",
  "title": "SecPal synthetic production host facts",
  "description": "Version 1 side-effect-free observations compared with the production inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hostname",
    "architecture",
    "os",
    "service_account",
    "ssh",
    "kernel",
    "runtime",
    "clock",
    "network",
    "tools",
    "filesystems",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "architecture": {
      "enum": ["amd64", "arm64"]
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_id", "installation_profile"],
      "properties": {
        "id": {
          "const": "ubuntu"
        },
        "version_id": {
          "const": "24.04"
        },
        "installation_profile": {
          "const": "ubuntu-server"
        }
      }
    },
    "service_account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "group",
        "uid",
        "gid",
        "supplementary_gids",
        "home",
        "shell",
        "interactive_login",
        "sudo_authorized",
        "host_privilege_authorized"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "$ref": "#/$defs/systemId"
        },
        "gid": {
          "$ref": "#/$defs/systemId"
        },
        "supplementary_gids": {
          "type": "array",
          "maxItems": 0
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "const": "/usr/sbin/nologin"
        },
        "interactive_login": {
          "const": false
        },
        "sudo_authorized": {
          "const": false
        },
        "host_privilege_authorized": {
          "const": false
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_root_login_permitted"],
      "properties": {
        "direct_root_login_permitted": {
          "const": false
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "package_source",
        "cgroup_version",
        "overlayfs_supported",
        "apparmor_enabled",
        "seccomp_enabled"
      ],
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "package_source": {
          "const": "ubuntu-archive"
        },
        "cgroup_version": {
          "const": 2
        },
        "overlayfs_supported": {
          "const": true
        },
        "apparmor_enabled": {
          "const": true
        },
        "seccomp_enabled": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker_engine_version",
        "docker_compose_version",
        "installation",
        "rootless",
        "daemon_running",
        "daemon_endpoint",
        "socket",
        "data_root"
      ],
      "properties": {
        "docker_engine_version": {
          "$ref": "#/$defs/version"
        },
        "docker_compose_version": {
          "$ref": "#/$defs/version"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "engine_package", "compose_package"],
          "properties": {
            "source": {
              "const": "docker-apt-repository"
            },
            "engine_package": {
              "const": "docker-ce"
            },
            "compose_package": {
              "const": "docker-compose-plugin"
            }
          }
        },
        "rootless": {
          "const": false
        },
        "daemon_running": {
          "const": true
        },
        "daemon_endpoint": {
          "const": "unix:///var/run/docker.sock"
        },
        "socket": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "uid",
            "gid",
            "mode",
            "service_account_can_connect"
          ],
          "properties": {
            "path": {
              "const": "/var/run/docker.sock"
            },
            "uid": {
              "const": 0
            },
            "gid": {
              "$ref": "#/$defs/systemId"
            },
            "mode": {
              "const": "0660"
            },
            "service_account_can_connect": {
              "const": false
            }
          }
        },
        "data_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synchronized", "offset_milliseconds"],
      "properties": {
        "synchronized": {
          "const": true
        },
        "offset_milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_address", "private_addresses"],
      "properties": {
        "public_address": {
          "type": "string",
          "minLength": 1
        },
        "private_addresses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "filesystems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "deployment_state",
        "postgresql_data",
        "private_application_storage",
        "public_application_storage",
        "edge_state",
        "acme_state",
        "crowdsec_state",
        "logs",
        "backup_staging",
        "docker_data_root"
      ],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/filesystemFact"
        },
        "deployment_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "postgresql_data": {
          "$ref": "#/$defs/filesystemFact"
        },
        "private_application_storage": {
          "$ref": "#/$defs/filesystemFact"
        },
        "public_application_storage": {
          "$ref": "#/$defs/filesystemFact"
        },
        "edge_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "acme_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "crowdsec_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "logs": {
          "$ref": "#/$defs/filesystemFact"
        },
        "backup_staging": {
          "$ref": "#/$defs/filesystemFact"
        },
        "docker_data_root": {
          "$ref": "#/$defs/filesystemFact"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_cpus",
        "memory_bytes",
        "storage_total_bytes",
        "total_inodes",
        "storage"
      ],
      "properties": {
        "logical_cpus": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "memory_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "storage_total_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "total_inodes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docker_data_root",
            "postgresql_data",
            "private_application_storage",
            "public_application_storage",
            "logs",
            "edge_state",
            "acme_state",
            "crowdsec_state",
            "backup_staging"
          ],
          "properties": {
            "docker_data_root": {
              "$ref": "#/$defs/headroomFact"
            },
            "postgresql_data": {
              "$ref": "#/$defs/headroomFact"
            },
            "private_application_storage": {
              "$ref": "#/$defs/headroomFact"
            },
            "public_application_storage": {
              "$ref": "#/$defs/headroomFact"
            },
            "logs": {
              "$ref": "#/$defs/headroomFact"
            },
            "edge_state": {
              "$ref": "#/$defs/headroomFact"
            },
            "acme_state": {
              "$ref": "#/$defs/headroomFact"
            },
            "crowdsec_state": {
              "$ref": "#/$defs/headroomFact"
            },
            "backup_staging": {
              "$ref": "#/$defs/headroomFact"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "systemId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967294
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "filesystemFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "filesystem",
        "local",
        "mount_read_only",
        "d_type",
        "xfs_ftype"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "enum": ["ext4", "xfs"]
        },
        "local": {
          "const": true
        },
        "mount_read_only": {
          "const": false
        },
        "d_type": {
          "const": true
        },
        "xfs_ftype": {
          "type": ["boolean", "null"]
        }
      }
    },
    "headroomFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_bytes",
        "free_percent",
        "free_inodes",
        "free_inode_percent"
      ],
      "properties": {
        "free_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "free_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "free_inodes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "free_inode_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
