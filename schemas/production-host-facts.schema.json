{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/deployment/schemas/production-host-facts.schema.json",
  "title": "SecPal production host facts",
  "description": "Version 2 closed Rocky/SELinux effective-host observations compared with the production inventory; synthetic fixtures are explicitly marked and cannot be native evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "hostname",
    "architecture",
    "cpu",
    "os",
    "service_account",
    "ssh",
    "kernel",
    "selinux",
    "runtime",
    "clock",
    "network",
    "path_access",
    "tools",
    "filesystems",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "evidence_class": {
      "enum": ["synthetic", "rocky-native"]
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "architecture": {
      "enum": ["amd64", "arm64"]
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission_method", "x86_64_level", "qualified"],
      "properties": {
        "admission_method": {
          "enum": ["glibc-loader-hwcaps", "rocky-aarch64-native"]
        },
        "x86_64_level": {
          "type": ["string", "null"],
          "enum": ["x86-64-v3", null]
        },
        "qualified": { "const": true }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_id", "package_provenance", "updates"],
      "properties": {
        "id": {
          "const": "rocky"
        },
        "version_id": {
          "type": "string",
          "pattern": "^10\\.(?:[2-9]|10)$"
        },
        "package_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distribution",
            "gpg_key",
            "enabled_repository_ids",
            "rpm_signatures_verified",
            "external_repositories_enabled"
          ],
          "properties": {
            "distribution": {
              "const": "rocky"
            },
            "gpg_key": {
              "const": "RPM-GPG-KEY-Rocky-10"
            },
            "enabled_repository_ids": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "enum": ["baseos", "appstream", "extras"] },
              "allOf": [
                { "contains": { "const": "baseos" } },
                { "contains": { "const": "appstream" } },
                { "contains": { "const": "extras" } }
              ]
            },
            "rpm_signatures_verified": {
              "const": true
            },
            "external_repositories_enabled": {
              "const": false
            }
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism",
            "reviewed",
            "automatic",
            "releasever",
            "automatic_reboot"
          ],
          "properties": {
            "mechanism": {
              "const": "dnf4"
            },
            "reviewed": {
              "const": true
            },
            "automatic": {
              "const": false
            },
            "releasever": {
              "const": "10"
            },
            "automatic_reboot": {
              "const": false
            }
          }
        }
      }
    },
    "service_account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "group",
        "uid",
        "gid",
        "supplementary_gids",
        "home",
        "containers_configuration_account_writable",
        "shell",
        "interactive_login",
        "sudo_authorized",
        "host_privilege_authorized",
        "rootful_runtime_authorized",
        "system_unit_authorized",
        "remote_runtime_authorized"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "$ref": "#/$defs/systemId"
        },
        "gid": {
          "$ref": "#/$defs/systemId"
        },
        "supplementary_gids": {
          "type": "array",
          "maxItems": 0
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "containers_configuration_account_writable": {
          "const": false
        },
        "shell": {
          "const": "/usr/sbin/nologin"
        },
        "interactive_login": {
          "const": false
        },
        "sudo_authorized": {
          "const": false
        },
        "host_privilege_authorized": {
          "const": false
        },
        "rootful_runtime_authorized": {
          "const": false
        },
        "system_unit_authorized": {
          "const": false
        },
        "remote_runtime_authorized": {
          "const": false
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_root_login_permitted"],
      "properties": {
        "direct_root_login_permitted": {
          "const": false
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "package_architecture",
        "package_source",
        "package_repository_id",
        "package_owned",
        "cgroup_version",
        "overlayfs_supported",
        "seccomp_available_to_podman"
      ],
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "package_architecture": {
          "enum": ["amd64", "arm64"]
        },
        "package_source": {
          "const": "rocky-baseos"
        },
        "package_repository_id": {
          "const": "baseos"
        },
        "package_owned": {
          "const": true
        },
        "cgroup_version": {
          "const": 2
        },
        "overlayfs_supported": {
          "const": true
        },
        "seccomp_available_to_podman": {
          "const": true
        }
      }
    },
    "selinux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "policy",
        "container_policy_package",
        "workload",
        "persistent_labels",
        "global_policy_weakened"
      ],
      "properties": {
        "enabled": { "const": true },
        "mode": { "const": "enforcing" },
        "policy": { "const": "targeted" },
        "container_policy_package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "installed",
            "source",
            "repository_id",
            "signature_verified"
          ],
          "properties": {
            "name": { "const": "container-selinux" },
            "installed": { "const": true },
            "source": { "const": "rocky-appstream" },
            "repository_id": { "const": "appstream" },
            "signature_verified": { "const": true }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_type",
            "process_mcs",
            "storage_type",
            "storage_mcs",
            "label_disabled",
            "intended_access_succeeded",
            "cross_boundary_process_type",
            "cross_boundary_process_mcs",
            "cross_boundary_access_denied",
            "denial_cause",
            "avc_denial_observed",
            "dac_would_allow_cross_boundary",
            "target_existed"
          ],
          "properties": {
            "process_type": { "const": "container_t" },
            "process_mcs": { "$ref": "#/$defs/mcsRange" },
            "storage_type": { "const": "container_file_t" },
            "storage_mcs": { "$ref": "#/$defs/mcsRange" },
            "label_disabled": { "const": false },
            "intended_access_succeeded": { "const": true },
            "cross_boundary_process_type": { "const": "container_t" },
            "cross_boundary_process_mcs": { "$ref": "#/$defs/mcsRange" },
            "cross_boundary_access_denied": { "const": true },
            "denial_cause": { "const": "selinux" },
            "avc_denial_observed": { "const": true },
            "dac_would_allow_cross_boundary": { "const": true },
            "target_existed": { "const": true }
          }
        },
        "persistent_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism",
            "fcontext_rule_present",
            "restorecon_verified",
            "chcon_only"
          ],
          "properties": {
            "mechanism": { "const": "semanage-fcontext-restorecon" },
            "fcontext_rule_present": { "const": true },
            "restorecon_verified": { "const": true },
            "chcon_only": { "const": false }
          }
        },
        "global_policy_weakened": { "const": false }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "effective_oci_runtime",
        "rootless",
        "owner_uid",
        "owner_gid",
        "installation",
        "user_namespace",
        "systemd_user",
        "quadlet",
        "storage",
        "network",
        "api",
        "updates",
        "registries",
        "security"
      ],
      "properties": {
        "engine": {
          "const": "podman"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "effective_oci_runtime": {
          "const": "crun"
        },
        "rootless": {
          "const": true
        },
        "owner_uid": {
          "$ref": "#/$defs/systemId"
        },
        "owner_gid": {
          "$ref": "#/$defs/systemId"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "distribution",
            "external_repository",
            "installed_packages",
            "installed_nevras",
            "package_repositories",
            "rpm_signatures_verified",
            "forbidden_packages_present"
          ],
          "properties": {
            "source": {
              "const": "rocky-official"
            },
            "distribution": {
              "const": "rocky"
            },
            "external_repository": {
              "const": false
            },
            "installed_packages": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "podman",
                "conmon",
                "crun",
                "netavark",
                "aardvark_dns",
                "passt",
                "shadow_utils_subid",
                "systemd",
                "container_selinux",
                "audit",
                "policycoreutils",
                "policycoreutils_python_utils",
                "selinux_policy_targeted"
              ],
              "properties": {
                "podman": { "const": "podman" },
                "conmon": { "const": "conmon" },
                "crun": { "const": "crun" },
                "netavark": { "const": "netavark" },
                "aardvark_dns": { "const": "aardvark-dns" },
                "passt": { "const": "passt" },
                "shadow_utils_subid": { "const": "shadow-utils-subid" },
                "systemd": { "const": "systemd" },
                "container_selinux": { "const": "container-selinux" },
                "audit": { "const": "audit" },
                "policycoreutils": { "const": "policycoreutils" },
                "policycoreutils_python_utils": {
                  "const": "policycoreutils-python-utils"
                },
                "selinux_policy_targeted": {
                  "const": "selinux-policy-targeted"
                }
              }
            },
            "installed_nevras": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "podman",
                "conmon",
                "crun",
                "netavark",
                "aardvark_dns",
                "passt",
                "shadow_utils_subid",
                "systemd",
                "container_selinux",
                "audit",
                "policycoreutils",
                "policycoreutils_python_utils",
                "selinux_policy_targeted"
              ],
              "properties": {
                "podman": { "$ref": "#/$defs/nevra" },
                "conmon": { "$ref": "#/$defs/nevra" },
                "crun": { "$ref": "#/$defs/nevra" },
                "netavark": { "$ref": "#/$defs/nevra" },
                "aardvark_dns": { "$ref": "#/$defs/nevra" },
                "passt": { "$ref": "#/$defs/nevra" },
                "shadow_utils_subid": { "$ref": "#/$defs/nevra" },
                "systemd": { "$ref": "#/$defs/nevra" },
                "container_selinux": { "$ref": "#/$defs/nevra" },
                "audit": { "$ref": "#/$defs/nevra" },
                "policycoreutils": { "$ref": "#/$defs/nevra" },
                "policycoreutils_python_utils": { "$ref": "#/$defs/nevra" },
                "selinux_policy_targeted": { "$ref": "#/$defs/nevra" }
              }
            },
            "package_repositories": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "podman",
                "conmon",
                "crun",
                "netavark",
                "aardvark_dns",
                "passt",
                "shadow_utils_subid",
                "systemd",
                "container_selinux",
                "audit",
                "policycoreutils",
                "policycoreutils_python_utils",
                "selinux_policy_targeted"
              ],
              "properties": {
                "podman": { "const": "appstream" },
                "conmon": { "const": "appstream" },
                "crun": { "const": "appstream" },
                "netavark": { "const": "appstream" },
                "aardvark_dns": { "const": "appstream" },
                "passt": { "const": "appstream" },
                "shadow_utils_subid": { "const": "baseos" },
                "systemd": { "const": "baseos" },
                "container_selinux": { "const": "appstream" },
                "audit": { "const": "baseos" },
                "policycoreutils": { "const": "baseos" },
                "policycoreutils_python_utils": { "const": "appstream" },
                "selinux_policy_targeted": { "const": "baseos" }
              }
            },
            "rpm_signatures_verified": { "const": true },
            "forbidden_packages_present": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "user_namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account",
            "subuid",
            "subgid",
            "newuidmap_effective",
            "newgidmap_effective"
          ],
          "properties": {
            "account": {
              "type": "string",
              "minLength": 1
            },
            "subuid": {
              "$ref": "#/$defs/subordinateIdFact"
            },
            "subgid": {
              "$ref": "#/$defs/subordinateIdFact"
            },
            "newuidmap_effective": {
              "const": true
            },
            "newgidmap_effective": {
              "const": true
            }
          }
        },
        "systemd_user": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manager_available",
            "starts_at_boot",
            "linger_enabled",
            "dbus_session_available"
          ],
          "properties": {
            "manager_available": {
              "const": true
            },
            "starts_at_boot": {
              "const": true
            },
            "linger_enabled": {
              "const": true
            },
            "dbus_session_available": {
              "const": true
            }
          }
        },
        "quadlet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "orchestrator",
            "generator_path",
            "unit_files_uid",
            "unit_files_gid",
            "unit_files_mode",
            "effective_search_paths",
            "persistent_search_path_configuration_account_writable",
            "tree_symlinks_present",
            "tree_service_account_can_read",
            "tree_service_account_can_traverse",
            "tree_service_account_can_write"
          ],
          "properties": {
            "available": { "const": true },
            "orchestrator": { "const": "systemd-user" },
            "generator_path": {
              "const": "/usr/lib/systemd/user-generators/podman-user-generator"
            },
            "unit_files_uid": { "const": 0 },
            "unit_files_gid": { "const": 0 },
            "unit_files_mode": { "const": "0644" },
            "effective_search_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "persistent_search_path_configuration_account_writable": {
              "const": false
            },
            "tree_symlinks_present": { "const": false },
            "tree_service_account_can_read": { "const": true },
            "tree_service_account_can_traverse": { "const": true },
            "tree_service_account_can_write": { "const": false }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graphroot",
            "runroot",
            "driver",
            "transient_store",
            "graphroot_reconstructable"
          ],
          "properties": {
            "graphroot": { "type": "string", "minLength": 1 },
            "runroot": { "type": "string", "minLength": 1 },
            "driver": { "const": "overlay" },
            "transient_store": { "const": false },
            "graphroot_reconstructable": { "const": true }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "dns_backend",
            "rootless_transport",
            "host_network",
            "unprivileged_port_override"
          ],
          "properties": {
            "backend": { "const": "netavark" },
            "dns_backend": { "const": "aardvark-dns" },
            "rootless_transport": { "const": "pasta" },
            "host_network": { "const": false },
            "unprivileged_port_override": { "const": false }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection",
            "remote",
            "service_enabled",
            "socket_enabled",
            "tcp_listener",
            "application_dependency",
            "podman_socket_mounted",
            "docker_socket_mounted",
            "docker_api_dependency"
          ],
          "properties": {
            "connection": { "const": "local-cli" },
            "remote": { "const": false },
            "service_enabled": { "const": false },
            "socket_enabled": { "const": false },
            "tcp_listener": { "const": false },
            "application_dependency": { "const": false },
            "podman_socket_mounted": { "const": false },
            "docker_socket_mounted": { "const": false },
            "docker_api_dependency": { "const": false }
          }
        },
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automatic",
            "automatic_service_restart",
            "major_version_automatic",
            "image_auto_update",
            "auto_update_timer_enabled"
          ],
          "properties": {
            "automatic": { "const": false },
            "automatic_service_restart": { "const": false },
            "major_version_automatic": { "const": false },
            "image_auto_update": { "const": false },
            "auto_update_timer_enabled": { "const": false }
          }
        },
        "registries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secpal_references_fully_qualified",
            "secpal_mirrors",
            "secpal_location_rewrite",
            "ghcr_insecure",
            "fallback_enabled",
            "short_name_resolution_required"
          ],
          "properties": {
            "secpal_references_fully_qualified": { "const": true },
            "secpal_mirrors": { "type": "array", "maxItems": 0 },
            "secpal_location_rewrite": { "const": false },
            "ghcr_insecure": { "const": false },
            "fallback_enabled": { "const": false },
            "short_name_resolution_required": { "const": false }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "privileged",
            "seccomp_enabled",
            "seccomp_profile",
            "digest_only_images",
            "non_root_processes",
            "added_capabilities"
          ],
          "properties": {
            "privileged": { "const": false },
            "seccomp_enabled": { "const": true },
            "seccomp_profile": { "const": "runtime-default" },
            "digest_only_images": { "const": true },
            "non_root_processes": { "const": true },
            "added_capabilities": { "type": "array", "maxItems": 0 }
          }
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synchronized", "offset_milliseconds"],
      "properties": {
        "synchronized": {
          "const": true
        },
        "offset_milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_address", "private_addresses"],
      "properties": {
        "public_address": {
          "type": "string",
          "minLength": 1
        },
        "private_addresses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "path_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_account_home",
        "systemd_runtime_directory",
        "podman_runroot",
        "quadlet_definitions"
      ],
      "properties": {
        "service_account_home": {
          "$ref": "#/$defs/pathAccessFact"
        },
        "systemd_runtime_directory": {
          "$ref": "#/$defs/pathAccessFact"
        },
        "podman_runroot": {
          "$ref": "#/$defs/pathAccessFact"
        },
        "quadlet_definitions": {
          "$ref": "#/$defs/pathAccessFact"
        }
      }
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "filesystems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "deployment_state",
        "postgresql_data",
        "private_application_storage",
        "public_application_storage",
        "valkey_data",
        "edge_state",
        "acme_state",
        "crowdsec_state",
        "logs",
        "backup_staging",
        "podman_graph_root"
      ],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/filesystemFact"
        },
        "deployment_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "postgresql_data": {
          "$ref": "#/$defs/filesystemFact"
        },
        "private_application_storage": {
          "$ref": "#/$defs/filesystemFact"
        },
        "public_application_storage": {
          "$ref": "#/$defs/filesystemFact"
        },
        "valkey_data": {
          "$ref": "#/$defs/filesystemFact"
        },
        "edge_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "acme_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "crowdsec_state": {
          "$ref": "#/$defs/filesystemFact"
        },
        "logs": {
          "$ref": "#/$defs/filesystemFact"
        },
        "backup_staging": {
          "$ref": "#/$defs/filesystemFact"
        },
        "podman_graph_root": {
          "$ref": "#/$defs/filesystemFact"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_cpus",
        "memory_bytes",
        "storage_total_bytes",
        "total_inodes",
        "storage"
      ],
      "properties": {
        "logical_cpus": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "memory_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "storage_total_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "total_inodes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "podman_graph_root",
            "postgresql_data",
            "private_application_storage",
            "public_application_storage",
            "valkey_data",
            "logs",
            "edge_state",
            "acme_state",
            "crowdsec_state",
            "backup_staging"
          ],
          "properties": {
            "podman_graph_root": {
              "$ref": "#/$defs/headroomFact"
            },
            "postgresql_data": {
              "$ref": "#/$defs/headroomFact"
            },
            "private_application_storage": {
              "$ref": "#/$defs/headroomFact"
            },
            "public_application_storage": {
              "$ref": "#/$defs/headroomFact"
            },
            "valkey_data": {
              "$ref": "#/$defs/headroomFact"
            },
            "logs": {
              "$ref": "#/$defs/headroomFact"
            },
            "edge_state": {
              "$ref": "#/$defs/headroomFact"
            },
            "acme_state": {
              "$ref": "#/$defs/headroomFact"
            },
            "crowdsec_state": {
              "$ref": "#/$defs/headroomFact"
            },
            "backup_staging": {
              "$ref": "#/$defs/headroomFact"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "systemId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967294
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "nevra": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.+~^:-]+$"
    },
    "mcsRange": {
      "type": "string",
      "pattern": "^s0:c[0-9]{1,4},c[0-9]{1,4}$"
    },
    "subordinateIdFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "start",
        "count",
        "source_entry_count",
        "overlaps_other_accounts",
        "overlaps_host_identities"
      ],
      "properties": {
        "source": {
          "enum": ["/etc/subuid", "/etc/subgid"]
        },
        "start": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 4294901759
        },
        "count": {
          "type": "integer",
          "const": 65536
        },
        "source_entry_count": {
          "type": "integer",
          "const": 1
        },
        "overlaps_other_accounts": {
          "const": false
        },
        "overlaps_host_identities": {
          "const": false
        }
      }
    },
    "pathAccessFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "uid",
        "gid",
        "mode",
        "service_account_can_write",
        "ancestors_service_account_can_write",
        "local"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "$ref": "#/$defs/systemId"
        },
        "gid": {
          "$ref": "#/$defs/systemId"
        },
        "mode": {
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "service_account_can_write": {
          "type": "boolean"
        },
        "ancestors_service_account_can_write": {
          "type": "boolean"
        },
        "local": {
          "const": true
        }
      }
    },
    "filesystemFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access",
        "filesystem",
        "mount_read_only",
        "d_type",
        "xfs_ftype"
      ],
      "properties": {
        "access": {
          "$ref": "#/$defs/pathAccessFact"
        },
        "filesystem": {
          "enum": ["ext4", "xfs"]
        },
        "mount_read_only": {
          "const": false
        },
        "d_type": {
          "const": true
        },
        "xfs_ftype": {
          "type": ["boolean", "null"]
        }
      }
    },
    "headroomFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_total_bytes",
        "free_bytes",
        "free_percent",
        "filesystem_total_inodes",
        "free_inodes",
        "free_inode_percent"
      ],
      "properties": {
        "filesystem_total_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "free_bytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "free_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "filesystem_total_inodes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "free_inodes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "free_inode_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
