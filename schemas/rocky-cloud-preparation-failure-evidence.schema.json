{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/deployment/schemas/rocky-cloud-preparation-failure-evidence.schema.json",
  "title": "Rocky GCP preparation failure evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_sha",
    "trusted_control_sha",
    "run_id",
    "run_attempt",
    "phase",
    "exit_status",
    "guest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "target_sha": { "$ref": "#/$defs/sha" },
    "trusted_control_sha": { "$ref": "#/$defs/sha" },
    "run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "run_attempt": { "type": "string", "pattern": "^[1-9][0-9]{0,2}$" },
    "phase": {
      "enum": [
        "guest-identity",
        "repositories",
        "packages",
        "selinux",
        "runtime-account",
        "subids",
        "systemd-user",
        "quadlet-authority",
        "fixture",
        "pre-reboot",
        "post-reboot-identity",
        "post-reboot-selinux",
        "cloud-identity",
        "evidence-collection",
        "evidence-validation"
      ]
    },
    "exit_status": { "type": "integer", "minimum": 1, "maximum": 255 },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_id", "uname_machine"],
      "properties": {
        "id": { "$ref": "#/$defs/guest_fact" },
        "version_id": { "$ref": "#/$defs/guest_fact" },
        "uname_machine": { "$ref": "#/$defs/guest_fact" }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "enabled",
        "unexpected_enabled",
        "missing_required"
      ],
      "properties": {
        "stage": { "enum": ["pre-admission", "final-admission"] },
        "enabled": { "$ref": "#/$defs/repository_ids" },
        "unexpected_enabled": { "$ref": "#/$defs/repository_ids" },
        "missing_required": { "$ref": "#/$defs/required_repository_ids" }
      }
    },
    "repository_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "reason"],
      "properties": {
        "operation": {
          "enum": [
            "validate-dnf4",
            "load-reviewed-provider-repositories",
            "observe-initial-enabled-repositories",
            "validate-initial-pre-admission",
            "observe-available-repository-definitions",
            "validate-required-repository-definitions",
            "install-repository-management-prerequisite",
            "enable-required-rocky-repository",
            "observe-normalized-pre-removal-state",
            "validate-normalized-pre-removal-state",
            "disable-reviewed-provider-repository",
            "observe-final-repository-state",
            "validate-final-repository-state"
          ]
        },
        "reason": {
          "enum": [
            "command-failed",
            "parse-failed",
            "observation-limit-exceeded",
            "invalid-repository-id",
            "required-repository-definition-unavailable",
            "package-transaction-failed",
            "repository-mutation-failed",
            "postcondition-failed",
            "profile-invalid"
          ]
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "validate-required-repository-definitions",
                  "enable-required-rocky-repository",
                  "disable-reviewed-provider-repository"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": { "required": ["repository_id"] },
          "else": { "not": { "required": ["repository_id"] } }
        }
      ]
    },
    "fixture_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "reason"],
      "properties": {
        "operation": {
          "enum": [
            "pull-immutable-fixture",
            "verify-immutable-fixture-present",
            "inspect-resolved-arm64-child",
            "validate-resolved-arm64-child"
          ]
        },
        "reason": { "enum": ["command-failed", "postcondition-failed"] }
      }
    },
    "collection_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "operation", "reason"],
      "properties": {
        "layer": {
          "enum": ["observation", "normalization", "admission", "assembly"]
        },
        "operation": {
          "enum": [
            "read-os-release",
            "query-architecture",
            "query-dnf-version",
            "query-releasever",
            "query-selinux-mode",
            "query-selinux-enabled",
            "query-selinux-policy",
            "query-enabled-repositories",
            "resolve-service-account",
            "read-subuid",
            "read-subgid",
            "query-effective-identities",
            "query-supplementary-groups",
            "query-podman-info",
            "resolve-rootless-graphroot",
            "resolve-service-account-home",
            "inspect-fixture-repo-digests",
            "read-boot-id",
            "read-memory-info",
            "query-root-filesystem",
            "query-cpu-count",
            "query-update-unit",
            "read-container-config",
            "query-podman-version",
            "query-cgroup-filesystem",
            "query-systemd-user",
            "query-podman-socket",
            "query-podman-socket-path",
            "query-environment-authority",
            "query-sudo-authority",
            "query-quadlet-authority",
            "query-linger",
            "verify-fixture-present",
            "query-cloud-identity-marker",
            "query-package-nevra",
            "resolve-package-repository",
            "query-installed-payload-digest",
            "download-official-package",
            "inspect-official-package-payload",
            "verify-package-signature",
            "verify-rocky-signing-key",
            "write-evidence",
            "write-collection-diagnostic",
            "normalize-os-release",
            "normalize-repositories",
            "normalize-subuid",
            "normalize-subgid",
            "normalize-subuid-population",
            "normalize-subgid-population",
            "normalize-fixture-repo-digests",
            "admit-fixture-arm64-child",
            "validate-fixture-evidence",
            "normalize-memory",
            "normalize-podman-info",
            "normalize-container-label-config",
            "normalize-package-evidence",
            "admit-package-repository",
            "admit-package-payload",
            "admit-package-signature",
            "admit-package-identity",
            "admit-immutable-shas",
            "admit-provider-image",
            "admit-guest-identity",
            "admit-update-contract",
            "admit-selinux",
            "admit-repositories",
            "normalize-service-account",
            "normalize-unit-status",
            "normalize-sudo-authority",
            "normalize-quadlet-authority",
            "admit-subids",
            "admit-rootless-graphroot",
            "admit-reboot-persistence",
            "admit-package-set",
            "assemble-evidence",
            "admit-run-identity",
            "admit-fixture-present",
            "admit-hardware",
            "admit-runtime",
            "admit-service-account",
            "admit-cloud-identity",
            "validate-collector-diagnostic"
          ]
        },
        "reason": {
          "enum": [
            "command-failed",
            "observation-failed",
            "observation-limit-exceeded",
            "representation-invalid",
            "subject-invalid",
            "wrong-type",
            "duplicate-observation",
            "cardinality-invalid",
            "invariant-failed",
            "internal-error",
            "postcondition-failed"
          ]
        },
        "subject": {
          "enum": [
            "podman",
            "conmon",
            "crun",
            "netavark",
            "aardvark-dns",
            "passt",
            "shadow-utils-subid",
            "systemd",
            "container-selinux",
            "audit",
            "policycoreutils",
            "policycoreutils-python-utils",
            "selinux-policy-targeted",
            "curl",
            "dnf",
            "git",
            "jq",
            "nftables",
            "openssh-server",
            "sudo",
            "python3-jsonschema",
            "dnf-plugins-core",
            "dnf-automatic.timer",
            "dnf-automatic-install.timer",
            "dnf-automatic-download.timer",
            "dnf-automatic-notifyonly.timer",
            "podman.socket"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "read-os-release",
                  "query-architecture",
                  "query-dnf-version",
                  "query-releasever",
                  "query-selinux-mode",
                  "query-selinux-enabled",
                  "query-selinux-policy",
                  "query-enabled-repositories",
                  "resolve-service-account",
                  "read-subuid",
                  "read-subgid",
                  "query-effective-identities",
                  "query-supplementary-groups",
                  "query-podman-info",
                  "resolve-rootless-graphroot",
                  "resolve-service-account-home",
                  "inspect-fixture-repo-digests",
                  "read-boot-id",
                  "read-memory-info",
                  "query-root-filesystem",
                  "query-cpu-count",
                  "query-update-unit",
                  "read-container-config",
                  "query-podman-version",
                  "query-cgroup-filesystem",
                  "query-systemd-user",
                  "query-podman-socket",
                  "query-podman-socket-path",
                  "query-environment-authority",
                  "query-sudo-authority",
                  "query-quadlet-authority",
                  "query-linger",
                  "verify-fixture-present",
                  "query-cloud-identity-marker",
                  "query-package-nevra",
                  "resolve-package-repository",
                  "query-installed-payload-digest",
                  "download-official-package",
                  "inspect-official-package-payload",
                  "verify-package-signature",
                  "verify-rocky-signing-key",
                  "write-evidence",
                  "write-collection-diagnostic"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "layer": { "const": "observation" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "normalize-os-release",
                  "normalize-repositories",
                  "normalize-subuid",
                  "normalize-subgid",
                  "normalize-subuid-population",
                  "normalize-subgid-population",
                  "normalize-fixture-repo-digests",
                  "normalize-memory",
                  "normalize-podman-info",
                  "normalize-container-label-config",
                  "normalize-package-evidence",
                  "normalize-service-account",
                  "normalize-unit-status",
                  "normalize-sudo-authority",
                  "normalize-quadlet-authority"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "layer": { "const": "normalization" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "admit-fixture-arm64-child",
                  "validate-fixture-evidence",
                  "admit-package-repository",
                  "admit-package-payload",
                  "admit-package-signature",
                  "admit-package-identity",
                  "admit-immutable-shas",
                  "admit-provider-image",
                  "admit-guest-identity",
                  "admit-update-contract",
                  "admit-selinux",
                  "admit-repositories",
                  "admit-subids",
                  "admit-rootless-graphroot",
                  "admit-reboot-persistence",
                  "admit-package-set",
                  "admit-run-identity",
                  "admit-fixture-present",
                  "admit-hardware",
                  "admit-runtime",
                  "admit-service-account",
                  "admit-cloud-identity"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "layer": { "const": "admission" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["assemble-evidence", "validate-collector-diagnostic"]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "layer": { "const": "assembly" } } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "repositories" } },
        "required": ["phase"]
      },
      "then": {},
      "else": {
        "not": {
          "anyOf": [
            { "required": ["repositories"] },
            { "required": ["repository_diagnostic"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "fixture" } },
        "required": ["phase"]
      },
      "then": { "required": ["fixture_diagnostic"] },
      "else": { "not": { "required": ["fixture_diagnostic"] } }
    },
    {
      "if": {
        "properties": { "phase": { "const": "evidence-collection" } },
        "required": ["phase"]
      },
      "then": { "required": ["collection_diagnostic"] },
      "else": { "not": { "required": ["collection_diagnostic"] } }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "guest_fact": {
      "anyOf": [
        { "const": "unavailable" },
        { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }
      ]
    },
    "repository_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "required_repository_ids": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    }
  }
}
