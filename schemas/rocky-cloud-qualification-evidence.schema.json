{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/deployment/schemas/rocky-cloud-qualification-evidence.schema.json",
  "title": "Target-owned Rocky native qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_sha",
    "native_observation",
    "quadlet_authority",
    "exit_status",
    "stdout_sha256",
    "stdout_bytes",
    "selinux_isolation",
    "seccomp_enforced",
    "cleanup_complete",
    "classification"
  ],
  "properties": {
    "schema_version": { "enum": [3, 4] },
    "target_sha": {
      "const": "c76742c828fefd71dda2b2d73fda6a0c43969426"
    },
    "native_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_sha",
        "trusted_control_sha",
        "qualification_run_id",
        "qualification_run_attempt",
        "host",
        "podman_version",
        "packages"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "target_sha": {
          "const": "c76742c828fefd71dda2b2d73fda6a0c43969426"
        },
        "trusted_control_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "qualification_run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "qualification_run_attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}$"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version_id", "architecture"],
          "properties": {
            "id": { "const": "rocky" },
            "version_id": { "const": "10.2" },
            "architecture": { "enum": ["aarch64", "x86_64"] }
          }
        },
        "podman_version": {
          "type": "string",
          "pattern": "^5\\.(?:8\\.(?:[2-9]|[1-9][0-9]+)|(?:9|[1-9][0-9]+)\\.[0-9]+)$"
        },
        "packages": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": { "$ref": "#/$defs/package" }
        }
      }
    },
    "quadlet_authority": { "$ref": "#/$defs/quadlet_authority" },
    "exit_status": { "const": 0 },
    "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "selinux_isolation": {
      "oneOf": [
        { "$ref": "#/$defs/selinux_isolation_v3" },
        { "$ref": "#/$defs/selinux_isolation" }
      ]
    },
    "seccomp_enforced": { "const": true },
    "cleanup_complete": { "const": true },
    "classification": { "const": "PASS" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 3 } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "selinux_isolation": { "$ref": "#/$defs/selinux_isolation_v3" }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 4 } },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "selinux_isolation": { "$ref": "#/$defs/selinux_isolation" }
        }
      }
    }
  ],
  "$defs": {
    "quadlet_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "invariant_owner",
        "runtime_uid",
        "unit_name",
        "fragment_path",
        "source_path",
        "drop_in_paths",
        "exec_start"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "invariant_owner": {
          "const": "quadlet_authority_contract.admit_quadlet_authority"
        },
        "runtime_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        },
        "unit_name": {
          "type": "string",
          "pattern": "^secpal-host-qualification-[A-Za-z0-9]{6}$"
        },
        "fragment_path": {
          "type": "string",
          "pattern": "^/run/user/[1-9][0-9]*/systemd/generator/secpal-host-qualification-[A-Za-z0-9]{6}\\.service$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^/etc/containers/systemd/users/[1-9][0-9]*/secpal-host-qualification-[A-Za-z0-9]{6}\\.container$"
        },
        "drop_in_paths": {
          "type": "array",
          "maxItems": 0
        },
        "exec_start": { "$ref": "#/$defs/quadlet_execution" }
      }
    },
    "quadlet_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "argv",
        "ignore_errors",
        "start_time",
        "stop_time",
        "pid",
        "code",
        "status"
      ],
      "properties": {
        "executable": { "const": "/usr/bin/podman" },
        "argv": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "prefixItems": [
            { "const": "/usr/bin/podman" },
            { "const": "run" },
            { "const": "--name" },
            {
              "type": "string",
              "pattern": "^secpal-host-qualification-[A-Za-z0-9]{6}$"
            },
            { "const": "--replace" },
            { "const": "--rm" },
            { "const": "--cgroups=split" },
            { "const": "--pull" },
            { "const": "never" },
            { "const": "--network" },
            { "const": "none" },
            { "const": "--sdnotify=conmon" },
            { "const": "-d" },
            { "const": "--cap-drop" },
            { "const": "all" },
            { "const": "--user" },
            { "const": "65532:65532" },
            { "const": "--security-opt=no-new-privileges" },
            {
              "const": "docker.io/library/alpine@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1"
            },
            { "const": "sleep" },
            { "const": "infinity" }
          ]
        },
        "ignore_errors": { "const": false },
        "start_time": { "type": "null" },
        "stop_time": { "type": "null" },
        "pid": { "const": 0 },
        "code": { "type": "null" },
        "status": { "const": "0/0" }
      }
    },
    "normalized_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "selinux_type", "mcs_categories"],
      "properties": {
        "raw": {
          "type": "string",
          "pattern": "^[^:\\s]+:[^:\\s]+:(?:container_t|container_file_t):s0:c(?:[0-9]|[1-9][0-9]{1,2}|10(?:[01][0-9]|2[0-3]))(?:,c(?:[0-9]|[1-9][0-9]{1,2}|10(?:[01][0-9]|2[0-3])))?$",
          "maxLength": 256
        },
        "selinux_type": { "enum": ["container_t", "container_file_t"] },
        "mcs_categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 1023 }
        }
      }
    },
    "selinux_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_owner",
        "process_contexts",
        "storage_context",
        "denial"
      ],
      "properties": {
        "invariant_owner": {
          "const": "selinux_isolation_contract.admit_selinux_isolation"
        },
        "process_contexts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/normalized_context" }
        },
        "storage_context": { "$ref": "#/$defs/normalized_context" },
        "denial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_time",
            "serial",
            "pid",
            "source_context",
            "target_context",
            "permissive",
            "proctitle",
            "syscall_pid",
            "syscall_command"
          ],
          "properties": {
            "event_time": {
              "type": "string",
              "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
            },
            "serial": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "source_context": { "type": "string", "maxLength": 256 },
            "target_context": { "type": "string", "maxLength": 256 },
            "permissive": { "const": 0 },
            "proctitle": { "const": "cat /foreign/marker" },
            "syscall_pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "syscall_command": { "const": "cat" }
          }
        }
      }
    },
    "selinux_isolation_v3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_owner",
        "process_contexts",
        "storage_context",
        "denial"
      ],
      "properties": {
        "invariant_owner": {
          "const": "selinux_isolation_contract.admit_selinux_isolation"
        },
        "process_contexts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/normalized_context" }
        },
        "storage_context": { "$ref": "#/$defs/normalized_context" },
        "denial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_time",
            "serial",
            "pid",
            "source_context",
            "target_context",
            "permission",
            "target_class",
            "target_path",
            "target_name",
            "permissive"
          ],
          "properties": {
            "event_time": {
              "type": "string",
              "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
            },
            "serial": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "source_context": { "type": "string", "maxLength": 256 },
            "target_context": { "type": "string", "maxLength": 256 },
            "permission": { "const": "read" },
            "target_class": { "const": "file" },
            "target_path": { "const": "/foreign/marker" },
            "target_name": { "const": "marker" },
            "permissive": { "const": 0 }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "epoch",
        "version",
        "release",
        "architecture",
        "nevra",
        "resolved_repository",
        "signature_verified",
        "signer_fingerprint",
        "payload_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9+_.-]{1,64}$"
        },
        "epoch": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,9})$" },
        "version": {
          "type": "string",
          "pattern": "^[0-9][a-zA-Z0-9+_.~^]*$",
          "maxLength": 128
        },
        "release": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9+_.~^]*$",
          "maxLength": 128
        },
        "architecture": { "enum": ["aarch64", "x86_64", "noarch"] },
        "nevra": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9+_.-]+-(?:[1-9][0-9]*:)?[0-9][a-zA-Z0-9+_.~^]*-[a-zA-Z0-9][a-zA-Z0-9+_.~^]*\\.(?:aarch64|x86_64|noarch)$",
          "maxLength": 256
        },
        "resolved_repository": { "enum": ["baseos", "appstream", "extras"] },
        "signature_verified": { "const": true },
        "signer_fingerprint": {
          "const": "fc226859c0860bf0ddb95b085b106c736fedfc85"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
