{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secpal.app/schemas/ci-cloud-evidence.schema.json",
  "title": "Disposable rootless application-workload evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "test", "workload"],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "run_attempt", "target_sha"],
      "properties": {
        "repository": {
          "const": "SecPal/deployment"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}$"
        },
        "target_sha": {
          "$ref": "#/$defs/workloadTargetSha"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_diagnostics",
        "phase_exit_statuses",
        "collection_exit_statuses",
        "result",
        "failed_admission_invariants"
      ],
      "properties": {
        "normalization_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "cleanup"],
          "properties": {
            "live": {
              "allOf": [
                {
                  "$ref": "#/$defs/normalizationDiagnostic"
                },
                {
                  "properties": {
                    "mode": {
                      "const": "live"
                    }
                  }
                }
              ]
            },
            "cleanup": {
              "allOf": [
                {
                  "$ref": "#/$defs/normalizationDiagnostic"
                },
                {
                  "properties": {
                    "mode": {
                      "const": "cleanup"
                    }
                  }
                }
              ]
            }
          }
        },
        "phase_exit_statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workload_prepare_start",
            "workload_cleanup",
            "trusted_quadlet_normalize_live",
            "trusted_quadlet_normalize_cleanup"
          ],
          "properties": {
            "workload_prepare_start": {
              "$ref": "#/$defs/exitStatus"
            },
            "workload_cleanup": {
              "$ref": "#/$defs/exitStatus"
            },
            "trusted_quadlet_normalize_live": {
              "$ref": "#/$defs/exitStatus"
            },
            "trusted_quadlet_normalize_cleanup": {
              "$ref": "#/$defs/exitStatus"
            }
          }
        },
        "collection_exit_statuses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "live", "post_cleanup"],
          "properties": {
            "baseline": {
              "$ref": "#/$defs/exitStatus"
            },
            "live": {
              "$ref": "#/$defs/exitStatus"
            },
            "post_cleanup": {
              "$ref": "#/$defs/exitStatus"
            }
          }
        },
        "result": {
          "enum": ["passed", "failed"]
        },
        "failed_admission_invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        }
      }
    },
    "workload": {
      "$ref": "#/$defs/workloadEvidence"
    }
  },
  "$defs": {
    "workloadTargetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workloadInstance": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "workloadHexDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workloadImageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workloadCreatedAt": { "pattern": "^[0-9T:+.Z-]{1,64}$" },
    "generatedServiceName": {
      "type": "string",
      "pattern": "^secpal-int-[0-9a-f]{12}-[a-z0-9-]+\\.service$",
      "maxLength": 96
    },
    "quadletUnitName": {
      "type": "string",
      "pattern": "^secpal-int-[0-9a-f]{12}(-[a-z0-9-]+\\.(container|network|volume)|\\.target)$",
      "maxLength": 96
    },
    "quadletSourcePath": {
      "type": "string",
      "pattern": "^/etc/containers/systemd/users/20000/secpal-int-[0-9a-f]{12}-[a-z0-9-]+\\.(container|network|volume)$",
      "maxLength": 192
    },
    "workloadNetworkNames": { "$ref": "#/$defs/stringArray" },
    "workloadPublishedPorts": { "$ref": "#/$defs/stringArray" },
    "cleanupInventoryNames": { "$ref": "#/$defs/stringArray" },
    "workloadProcessList": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/processFact" }
    },
    "exitStatus": { "type": "integer", "minimum": 0, "maximum": 255 },
    "invariantArray": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
    },
    "controlResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_present",
        "volume_present",
        "network_id",
        "volume_created_at"
      ],
      "properties": {
        "network_present": { "type": "boolean" },
        "volume_present": { "type": "boolean" },
        "network_id": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "volume_created_at": {
          "type": "string",
          "pattern": "^$|^[0-9T:+.Z-]{1,64}$"
        }
      }
    },
    "unitFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "uid", "gid", "mode", "sha256", "image"],
      "properties": {
        "name": { "$ref": "#/$defs/quadletUnitName" },
        "path": {
          "type": "string",
          "pattern": "^/etc/(containers/systemd/users/20000|systemd/user)/secpal-int-[0-9a-f]{12}",
          "maxLength": 192
        },
        "uid": { "const": 0 },
        "gid": { "const": 0 },
        "mode": { "const": "0644" },
        "sha256": { "$ref": "#/$defs/workloadHexDigest" },
        "image": { "type": "string", "maxLength": 512 }
      }
    },
    "dropInOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "gid", "mode"],
      "properties": {
        "uid": { "const": 20000 },
        "gid": { "const": 20000 },
        "mode": { "const": "0644" }
      }
    },
    "generatedServiceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "unit",
        "fragment_path",
        "fragment_uid",
        "fragment_gid",
        "fragment_mode",
        "fragment_sha256",
        "source_path",
        "drop_in_paths",
        "drop_in_owners",
        "drop_in_sha256",
        "environment",
        "active_state",
        "sub_state",
        "result",
        "exec_main_status",
        "main_pid",
        "control_group",
        "invocation_id"
      ],
      "properties": {
        "logical_name": {
          "enum": [
            "secrets-init",
            "postgres",
            "migrate",
            "api",
            "worker-general",
            "worker-hash-chain",
            "scheduler",
            "frontend",
            "gateway",
            "application-network",
            "edge-network",
            "secrets-volume",
            "private-storage-volume",
            "postgres-volume"
          ]
        },
        "unit": { "$ref": "#/$defs/generatedServiceName" },
        "fragment_path": {
          "type": "string",
          "pattern": "^/run/user/20000/systemd/generator/secpal-int-[0-9a-f]{12}-[a-z0-9-]+\\.service$",
          "maxLength": 192
        },
        "fragment_uid": { "const": 20000 },
        "fragment_gid": { "const": 20000 },
        "fragment_mode": { "const": "0644" },
        "fragment_sha256": { "$ref": "#/$defs/workloadHexDigest" },
        "source_path": { "$ref": "#/$defs/quadletSourcePath" },
        "drop_in_paths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^/run/user/20000/systemd/generator/",
            "maxLength": 256
          }
        },
        "drop_in_owners": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/dropInOwner" }
        },
        "drop_in_sha256": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/workloadHexDigest" }
        },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
            "maxLength": 128
          }
        },
        "active_state": { "$ref": "#/$defs/shortString" },
        "sub_state": { "$ref": "#/$defs/shortString" },
        "result": { "$ref": "#/$defs/shortString" },
        "exec_main_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "main_pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "control_group": {
          "type": "string",
          "pattern": "^$|^/",
          "maxLength": 256
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "workloadRole": {
      "enum": [
        "secrets-init",
        "postgres",
        "migrate",
        "api",
        "worker-general",
        "worker-hash-chain",
        "scheduler",
        "frontend",
        "gateway"
      ]
    },
    "idMapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_id", "host_id", "size"],
      "properties": {
        "container_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "host_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "idMap": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/idMapEntry" }
    },
    "userNamespaceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compat_mode",
        "create_options",
        "process_identity",
        "collector_identity",
        "uid_map",
        "gid_map",
        "collector_uid_map",
        "collector_gid_map",
        "configured_uid_map",
        "configured_gid_map",
        "podman_uid_map",
        "podman_gid_map"
      ],
      "properties": {
        "compat_mode": { "type": "string", "maxLength": 64 },
        "create_options": {
          "type": "array",
          "maxItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "process_identity": {
          "type": "string",
          "pattern": "^$|^user:\\[[0-9]{1,20}\\]$"
        },
        "collector_identity": {
          "type": "string",
          "pattern": "^user:\\[[0-9]{1,20}\\]$"
        },
        "uid_map": { "$ref": "#/$defs/idMap" },
        "gid_map": { "$ref": "#/$defs/idMap" },
        "collector_uid_map": { "$ref": "#/$defs/idMap" },
        "collector_gid_map": { "$ref": "#/$defs/idMap" },
        "configured_uid_map": { "$ref": "#/$defs/idMap" },
        "configured_gid_map": { "$ref": "#/$defs/idMap" },
        "podman_uid_map": { "$ref": "#/$defs/idMap" },
        "podman_gid_map": { "$ref": "#/$defs/idMap" }
      }
    },
    "containerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "name",
        "state",
        "pid",
        "exit_code",
        "health",
        "oci_runtime",
        "rootless",
        "privileged",
        "configured_user",
        "effective_uid",
        "effective_gid",
        "effective_supplementary_gids",
        "read_only_rootfs",
        "entrypoint",
        "command",
        "healthcheck_command",
        "pid_mode",
        "user_namespace",
        "ipc_mode",
        "uts_mode",
        "network_mode",
        "cap_add",
        "group_add",
        "effective_caps",
        "bounding_caps",
        "selinux_process_label",
        "selinux_mount_label",
        "effective_process_label",
        "effective_seccomp_mode",
        "devices_present",
        "mounts",
        "tmpfs",
        "remote_api_environment",
        "security_opt",
        "lifecycle_events",
        "networks",
        "published_ports",
        "auto_update",
        "systemd_unit",
        "container_cgroup",
        "lifecycle_service_invocation",
        "image",
        "image_id",
        "image_digest"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/workloadHexDigest" },
        "role": { "$ref": "#/$defs/workloadRole" },
        "name": {
          "type": "string",
          "pattern": "^secpal-int-[0-9a-f]{12}-[a-z0-9-]+$",
          "maxLength": 96
        },
        "state": {
          "enum": ["created", "configured", "exited", "running", "stopped"]
        },
        "pid": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "exit_code": { "type": "integer", "minimum": -1, "maximum": 255 },
        "health": { "enum": ["none", "starting", "healthy", "unhealthy"] },
        "oci_runtime": { "$ref": "#/$defs/shortString" },
        "rootless": { "type": "boolean" },
        "privileged": { "type": "boolean" },
        "configured_user": {
          "type": "string",
          "pattern": "^[0-9]{1,10}:[0-9]{1,10}$"
        },
        "effective_uid": {
          "type": "integer",
          "minimum": -1,
          "maximum": 4294967295
        },
        "effective_gid": {
          "type": "integer",
          "minimum": -1,
          "maximum": 4294967295
        },
        "effective_supplementary_gids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "read_only_rootfs": { "type": "boolean" },
        "entrypoint": { "$ref": "#/$defs/commandArray" },
        "command": { "$ref": "#/$defs/commandArray" },
        "healthcheck_command": { "$ref": "#/$defs/commandArray" },
        "pid_mode": { "$ref": "#/$defs/shortString" },
        "user_namespace": { "$ref": "#/$defs/userNamespaceFact" },
        "ipc_mode": { "$ref": "#/$defs/shortString" },
        "uts_mode": { "$ref": "#/$defs/shortString" },
        "network_mode": { "$ref": "#/$defs/shortString" },
        "cap_add": { "$ref": "#/$defs/stringArray" },
        "group_add": { "$ref": "#/$defs/stringArray" },
        "effective_caps": { "$ref": "#/$defs/stringArray" },
        "bounding_caps": { "$ref": "#/$defs/stringArray" },
        "selinux_process_label": { "type": "string", "maxLength": 256 },
        "selinux_mount_label": { "type": "string", "maxLength": 256 },
        "effective_process_label": { "type": "string", "maxLength": 256 },
        "effective_seccomp_mode": {
          "type": "integer",
          "enum": [-1, 2]
        },
        "devices_present": { "type": "boolean" },
        "mounts": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/containerMount" }
        },
        "tmpfs": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/containerTmpfs" }
        },
        "remote_api_environment": { "type": "boolean" },
        "security_opt": { "$ref": "#/$defs/stringArray" },
        "lifecycle_events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/containerLifecycleEvent" }
        },
        "networks": { "$ref": "#/$defs/workloadNetworkNames" },
        "published_ports": { "$ref": "#/$defs/workloadPublishedPorts" },
        "auto_update": { "type": "boolean" },
        "systemd_unit": { "$ref": "#/$defs/generatedServiceName" },
        "container_cgroup": { "type": "string", "maxLength": 256 },
        "lifecycle_service_invocation": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{32}$"
        },
        "image": { "type": "string", "maxLength": 512 },
        "image_id": { "$ref": "#/$defs/workloadImageDigest" },
        "image_digest": { "$ref": "#/$defs/workloadImageDigest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "running" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "user_namespace": {
                "properties": {
                  "process_identity": {
                    "pattern": "^user:\\[[0-9]{1,20}\\]$"
                  },
                  "uid_map": { "minItems": 1 },
                  "gid_map": { "minItems": 1 },
                  "collector_uid_map": { "minItems": 1 },
                  "collector_gid_map": { "minItems": 1 },
                  "podman_uid_map": { "minItems": 1 },
                  "podman_gid_map": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "exited" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "user_namespace": {
                "properties": {
                  "process_identity": { "const": "" },
                  "uid_map": { "maxItems": 0 },
                  "gid_map": { "maxItems": 0 },
                  "collector_uid_map": { "minItems": 1 },
                  "collector_gid_map": { "minItems": 1 },
                  "podman_uid_map": { "minItems": 1 },
                  "podman_gid_map": { "minItems": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "containerMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "destination", "rw"],
      "properties": {
        "type": { "enum": ["bind", "volume"] },
        "source": { "type": "string", "maxLength": 512 },
        "destination": { "type": "string", "pattern": "^/[^\\u0000]{0,255}$" },
        "rw": { "type": "boolean" }
      }
    },
    "containerTmpfs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "size_bytes", "mode", "uid", "gid", "flags"],
      "properties": {
        "destination": { "type": "string", "pattern": "^/[^\\u0000]{0,255}$" },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
        "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "gid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": ["nodev", "noexec", "nosuid", "rprivate", "rw", "tmpcopyup"]
          }
        }
      }
    },
    "containerLifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "time_nano"],
      "properties": {
        "status": { "enum": ["create", "start", "died"] },
        "time_nano": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999999999999
        }
      }
    },
    "podmanHealthTimerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_id", "timer", "service", "interval_usec"],
      "properties": {
        "container_id": { "$ref": "#/$defs/workloadHexDigest" },
        "timer": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}-(?:0|[1-9a-f][0-9a-f]{0,14}|[1-7][0-9a-f]{15})\\.timer$"
        },
        "service": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}-(?:0|[1-9a-f][0-9a-f]{0,14}|[1-7][0-9a-f]{15})\\.service$"
        },
        "interval_usec": { "enum": [5000000, 10000000] }
      }
    },
    "canonicalSystemdUnitName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:[A-Za-z0-9_.@:-]|\\\\x[0-9a-f]{2})+$",
      "not": { "pattern": "[\\u0000-\\u001f\\u007f\\u2028\\u2029]" }
    },
    "userWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_units", "jobs", "podman_health_timers"],
      "properties": {
        "active_units": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/canonicalSystemdUnitName" }
        },
        "jobs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/canonicalSystemdUnitName" }
        },
        "podman_health_timers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/podmanHealthTimerFact" }
        }
      }
    },
    "processFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "control_group", "uid", "gid", "count"],
      "properties": {
        "executable": {
          "oneOf": [
            { "const": "[permission-denied]" },
            { "type": "string", "pattern": "^/[^\\u0000]{0,511}$" }
          ]
        },
        "control_group": {
          "type": "string",
          "pattern": "^/user\\.slice/user-20000\\.slice/",
          "maxLength": 512
        },
        "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "gid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "count": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "baselineObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "target_sha",
        "target_admitted",
        "collector_uid",
        "collector_gid",
        "complete",
        "containers",
        "networks",
        "volumes",
        "migration_invocation_count",
        "podman_api",
        "user_work",
        "processes",
        "control_resources"
      ],
      "properties": {
        "phase": { "const": "baseline" },
        "target_sha": { "$ref": "#/$defs/workloadTargetSha" },
        "target_admitted": { "type": "boolean" },
        "collector_uid": { "const": 20000 },
        "collector_gid": { "const": 20000 },
        "complete": { "type": "boolean" },
        "containers": { "$ref": "#/$defs/stringArray" },
        "networks": { "$ref": "#/$defs/workloadNetworkNames" },
        "volumes": { "$ref": "#/$defs/stringArray" },
        "migration_invocation_count": { "const": 0 },
        "podman_api": { "type": "boolean" },
        "user_work": { "$ref": "#/$defs/userWork" },
        "processes": { "$ref": "#/$defs/workloadProcessList" },
        "control_resources": { "$ref": "#/$defs/controlResources" }
      }
    },
    "liveObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "target_sha",
        "target_admitted",
        "collector_uid",
        "collector_gid",
        "complete",
        "quadlet_search_paths",
        "installed_units",
        "generated_services",
        "containers",
        "networks",
        "volumes",
        "all_containers",
        "all_networks",
        "all_volumes",
        "podman_rootless",
        "oci_runtime",
        "podman_api",
        "user_work",
        "processes",
        "control_resources"
      ],
      "properties": {
        "phase": { "const": "live" },
        "target_sha": { "$ref": "#/$defs/workloadTargetSha" },
        "target_admitted": { "type": "boolean" },
        "collector_uid": { "const": 20000 },
        "collector_gid": { "const": 20000 },
        "complete": { "type": "boolean" },
        "quadlet_search_paths": { "$ref": "#/$defs/stringArray" },
        "installed_units": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/unitFact" }
        },
        "generated_services": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 14,
          "items": { "$ref": "#/$defs/generatedServiceFact" }
        },
        "containers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/containerFact" }
        },
        "podman_rootless": { "type": "boolean" },
        "oci_runtime": { "$ref": "#/$defs/shortString" },
        "networks": { "$ref": "#/$defs/workloadNetworkNames" },
        "volumes": { "$ref": "#/$defs/stringArray" },
        "all_containers": { "$ref": "#/$defs/cleanupInventoryNames" },
        "all_networks": { "$ref": "#/$defs/cleanupInventoryNames" },
        "all_volumes": { "$ref": "#/$defs/cleanupInventoryNames" },
        "podman_api": { "type": "boolean" },
        "user_work": { "$ref": "#/$defs/userWork" },
        "processes": { "$ref": "#/$defs/workloadProcessList" },
        "control_resources": { "$ref": "#/$defs/controlResources" }
      }
    },
    "cleanupObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "target_sha",
        "target_admitted",
        "collector_uid",
        "collector_gid",
        "complete",
        "owned_units",
        "generated_services",
        "containers",
        "networks",
        "volumes",
        "all_containers",
        "all_networks",
        "all_volumes",
        "migration_invocation_count",
        "podman_api",
        "user_work",
        "processes",
        "control_resources"
      ],
      "properties": {
        "phase": { "const": "post-cleanup" },
        "target_sha": { "$ref": "#/$defs/workloadTargetSha" },
        "target_admitted": { "type": "boolean" },
        "collector_uid": { "const": 20000 },
        "collector_gid": { "const": 20000 },
        "complete": { "type": "boolean" },
        "owned_units": { "$ref": "#/$defs/cleanupInventoryNames" },
        "generated_services": { "$ref": "#/$defs/stringArray" },
        "containers": { "$ref": "#/$defs/stringArray" },
        "networks": { "$ref": "#/$defs/workloadNetworkNames" },
        "volumes": { "$ref": "#/$defs/stringArray" },
        "all_containers": { "$ref": "#/$defs/cleanupInventoryNames" },
        "all_networks": { "$ref": "#/$defs/cleanupInventoryNames" },
        "all_volumes": { "$ref": "#/$defs/cleanupInventoryNames" },
        "migration_invocation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "podman_api": { "type": "boolean" },
        "user_work": { "$ref": "#/$defs/userWork" },
        "processes": { "$ref": "#/$defs/workloadProcessList" },
        "control_resources": { "$ref": "#/$defs/controlResources" }
      }
    },
    "workloadEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "claim_scope",
        "database_scope",
        "target_sha",
        "instance",
        "result",
        "failed_admission_invariants",
        "baseline",
        "live",
        "post_cleanup"
      ],
      "properties": {
        "protocol_version": { "const": 1 },
        "claim_scope": {
          "const": "disposable-rootless-application-integration"
        },
        "database_scope": {
          "const": "disposable-postgresql-18-fixture"
        },
        "target_sha": { "$ref": "#/$defs/workloadTargetSha" },
        "instance": { "$ref": "#/$defs/workloadInstance" },
        "result": { "enum": ["passed", "failed"] },
        "failed_admission_invariants": { "$ref": "#/$defs/invariantArray" },
        "baseline": { "$ref": "#/$defs/baselineObservation" },
        "live": { "$ref": "#/$defs/liveObservation" },
        "post_cleanup": { "$ref": "#/$defs/cleanupObservation" }
      },
      "allOf": [
        {
          "if": {
            "required": ["result"],
            "properties": { "result": { "const": "passed" } }
          },
          "then": {
            "properties": {
              "failed_admission_invariants": { "maxItems": 0 },
              "baseline": {
                "properties": {
                  "target_admitted": { "const": true },
                  "complete": { "const": true },
                  "podman_api": { "const": false },
                  "control_resources": {
                    "properties": {
                      "network_present": { "const": true },
                      "volume_present": { "const": true },
                      "network_id": { "$ref": "#/$defs/workloadHexDigest" },
                      "volume_created_at": {
                        "$ref": "#/$defs/workloadCreatedAt"
                      }
                    }
                  }
                }
              },
              "live": {
                "properties": {
                  "target_admitted": { "const": true },
                  "complete": { "const": true },
                  "quadlet_search_paths": {
                    "const": ["/etc/containers/systemd/users/20000"]
                  },
                  "installed_units": { "minItems": 15, "maxItems": 15 },
                  "generated_services": { "minItems": 14, "maxItems": 14 },
                  "containers": { "minItems": 9, "maxItems": 9 },
                  "networks": { "minItems": 2, "maxItems": 2 },
                  "volumes": { "minItems": 3, "maxItems": 3 },
                  "podman_rootless": { "const": true },
                  "oci_runtime": { "const": "crun" },
                  "podman_api": { "const": false },
                  "control_resources": {
                    "properties": {
                      "network_present": { "const": true },
                      "volume_present": { "const": true },
                      "network_id": { "$ref": "#/$defs/workloadHexDigest" },
                      "volume_created_at": {
                        "$ref": "#/$defs/workloadCreatedAt"
                      }
                    }
                  }
                }
              },
              "post_cleanup": {
                "properties": {
                  "target_admitted": { "const": true },
                  "complete": { "const": true },
                  "owned_units": { "maxItems": 0 },
                  "generated_services": { "maxItems": 0 },
                  "containers": { "maxItems": 0 },
                  "networks": { "maxItems": 0 },
                  "volumes": { "maxItems": 0 },
                  "migration_invocation_count": { "const": 1 },
                  "podman_api": { "const": false },
                  "control_resources": {
                    "properties": {
                      "network_present": { "const": true },
                      "volume_present": { "const": true },
                      "network_id": { "$ref": "#/$defs/workloadHexDigest" },
                      "volume_created_at": {
                        "$ref": "#/$defs/workloadCreatedAt"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "normalizationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "stage",
        "failure_reason",
        "command_status"
      ],
      "properties": {
        "mode": { "enum": ["live", "cleanup"] },
        "status": { "enum": [0, 1] },
        "stage": {
          "enum": [
            "complete",
            "instance-admission",
            "stop-existing-units",
            "manager-environment-read",
            "manager-environment-unset",
            "manager-environment-set",
            "pre-reload-manager-environment-read",
            "pre-reload-manager-environment-admission",
            "user-environment-generator-inventory-read",
            "user-environment-generator-inventory-admission",
            "user-environment-generator-presence-admission",
            "user-environment-generator-file-read",
            "user-environment-generator-file-admission",
            "user-environment-generator-content-admission",
            "user-environment-generator-metadata-admission",
            "daemon-reload",
            "post-reload-manager-environment-read",
            "post-reload-manager-environment-admission",
            "target-unit-admission",
            "generated-unit-admission",
            "target-start",
            "post-activation-manager-environment-read",
            "post-activation-manager-environment-admission",
            "quadlet-search-path-admission",
            "unreported"
          ]
        },
        "failure_reason": {
          "type": ["string", "null"],
          "enum": [
            "command-exit",
            "contract-rejected",
            "unexpected-error",
            null
          ]
        },
        "command_status": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 255
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": 0 },
            "stage": { "const": "complete" },
            "failure_reason": { "const": null },
            "command_status": { "const": null }
          }
        },
        {
          "properties": {
            "status": { "const": 1 },
            "stage": { "not": { "const": "complete" } },
            "failure_reason": {
              "enum": ["command-exit", "contract-rejected", "unexpected-error"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "failure_reason": { "const": "command-exit" }
                }
              },
              "then": {
                "properties": {
                  "command_status": { "type": "integer" }
                }
              },
              "else": {
                "properties": { "command_status": { "const": null } }
              }
            }
          ]
        }
      ]
    },
    "shortString": { "type": "string", "maxLength": 64 },
    "commandArray": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "maxLength": 4096 }
    }
  }
}
