FROM docker.io/library/caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f

USER root
RUN setcap -r /usr/bin/caddy
USER 10003:10003

# Default matches the gateway role in scripts/integration_runtime_contract.py.
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=12 CMD wget --no-check-certificate -q -T 3 -O /dev/null https://app.secpal.example.invalid:8443/health/live
